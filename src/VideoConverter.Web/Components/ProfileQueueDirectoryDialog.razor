@using VideoConverter.Common.Constants

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Queue Directory with Profile</MudText>
    </TitleContent>
    <DialogContent>
        <div @onkeydown="HandleKeyDown">
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Using profile: <strong>@Profile.Name</strong>
            </MudAlert>
            <EditForm @ref="_editForm" Model="@_formModel" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            @if (_validationErrors is not null && _validationErrors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">
                    <ul class="mb-0">
                        @foreach (var kvp in _validationErrors)
                        {
                            foreach (var message in kvp.Value)
                            {
                                <li><strong>@kvp.Key:</strong> @message</li>
                            }
                        }
                    </ul>
                </MudAlert>
            }
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.DirectoryPath" Label="Directory Path" Required="true" Variant="Variant.Outlined" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenDirectoryBrowser" Class="ml-2" Style="height: 56px;">
                    Browse
                </MudButton>
            </div>
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.OutputDirectory" Label="Output Directory" Required="true" Variant="Variant.Outlined" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenOutputDirectoryBrowser" Class="ml-2" Style="height: 56px;">
                    Browse
                </MudButton>
            </div>
            <MudTextField @bind-Value="_formModel.ExtensionsString" Label="File Extensions (comma-separated)" HelperText="e.g., .mkv,.mp4 (defaults to .mkv,.mp4 if empty)" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_formModel.Crf" Label="CRF (Quality)" HelperText="Lower is higher quality (18-28 recommended)" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_formModel.AudioBitrateKbps" Label="Audio Bitrate (Kbps)" Variant="Variant.Outlined" Class="mb-3" />
            <MudSelect T="AudioChannels?" @bind-Value="_formModel.AudioChannels" Label="Audio Channels" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="AudioChannels?" Value="@((AudioChannels?)null)">Keep source</MudSelectItem>
                <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Stereo20">Stereo 2.0</MudSelectItem>
                <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Surround51">Surround 5.1</MudSelectItem>
            </MudSelect>
            <MudSelect T="int?" @bind-Value="_formModel.Resolution" Label="Resolution" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="int?" Value="@((int?)null)">Keep source</MudSelectItem>
                @foreach (var resolution in ResolutionOptions.Allowed)
                {
                    <MudSelectItem T="int?" Value="@resolution">@($"{resolution}p")</MudSelectItem>
                }
            </MudSelect>
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.OutputFilenameTemplate" Label="Output Filename Template" Variant="Variant.Outlined" Class="flex-grow-1" />
                <TemplateHelpButton TemplateType="TemplateHelpDialog.TemplateType.Filename" Class="ml-1" />
            </div>
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.OutputPathTemplate" Label="Output Path Template" HelperText="e.g., {Type}/{Title}/Season {Season:00}" Variant="Variant.Outlined" Class="flex-grow-1" />
                <TemplateHelpButton TemplateType="TemplateHelpDialog.TemplateType.Path" Class="ml-1" />
            </div>
            <MudTextField @bind-Value="_formModel.AudioLanguagesString" Label="Audio Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_formModel.SubtitleLanguagesString" Label="Subtitle Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
            <MudSwitch @bind-Value="_formModel.VmafEnabled" Label="Enable VMAF Quality Scoring" Color="Color.Primary" Class="mb-3" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <text>Queueing...</text>
                }
                else
                {
                    <text>Queue Directory</text>
                }
            </MudButton>
            <MudButton Variant="Variant.Text" Disabled="@_isSubmitting" OnClick="HandleCancel">Cancel</MudButton>
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@using VideoConverter.Common.Models


@code {
    [CascadingParameter]
    public IDialogReference MudDialog { get; set; } = default!;

    [Parameter]
    public ProfileDto Profile { get; set; } = default!;

    [Parameter]
    public EventCallback<ProfileDirectoryQueueRequestDto> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Inject]
    private ILogger<ProfileQueueDirectoryDialog> Logger { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private IRequestValidator<ProfileDirectoryQueueRequestDto> ProfileDirectoryQueueValidator { get; set; } = null!;

    private EditForm _editForm = default!;
    private readonly DirectoryFormModel _formModel = new();
    private bool _isSubmitting;
    private IDictionary<string, string[]>? _validationErrors;

    protected override void OnInitialized()
    {
        Logger.LogDebug("ProfileQueueDirectoryDialog initializing for profile {ProfileId}", Profile.Id);
        _formModel.OutputDirectory = Profile.OutputDirectory ?? string.Empty;
        _formModel.Crf = Profile.Crf;
        _formModel.AudioBitrateKbps = Profile.AudioBitrateKbps;
        _formModel.AudioChannels = Profile.AudioChannels;
        _formModel.Resolution = Profile.Resolution ?? _formModel.Resolution;
        _formModel.OutputFilenameTemplate = Profile.OutputFilenameTemplate;
        _formModel.OutputPathTemplate = Profile.OutputPathTemplate;
        _formModel.AudioLanguagesString = Profile.AudioLanguages is not null ? string.Join(", ", Profile.AudioLanguages) : null;
        _formModel.SubtitleLanguagesString = Profile.SubtitleLanguages is not null ? string.Join(", ", Profile.SubtitleLanguages) : null;
        _formModel.VmafEnabled = Profile.VmafEnabled;
    }

    private async Task<bool> ValidateAndSetErrorsAsync<TRequest>(IRequestValidator<TRequest> validator, TRequest request)
    {
        var validation = await validator.ValidateAsync(request, CancellationToken.None).ConfigureAwait(false);
        if (!validation.IsValid)
        {
            _validationErrors = validation.ToDictionary();
            return false;
        }

        _validationErrors = null;
        return true;
    }

    private async Task HandleValidSubmit()
    {
        Logger.LogInformation("Form submission started. Directory: {DirectoryPath}, Output: {OutputDirectory}",
            _formModel.DirectoryPath, _formModel.OutputDirectory);
        _isSubmitting = true;
        try
        {
            var extensions = !string.IsNullOrWhiteSpace(_formModel.ExtensionsString)
                ? _formModel.ExtensionsString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                : null;

            var audioLanguages = !string.IsNullOrWhiteSpace(_formModel.AudioLanguagesString)
                ? _formModel.AudioLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                : null;
            var subtitleLanguages = !string.IsNullOrWhiteSpace(_formModel.SubtitleLanguagesString)
                ? _formModel.SubtitleLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                : null;

            Logger.LogDebug("Form data converted. Extensions: {Extensions}, AudioLanguages: {AudioLanguages}, SubtitleLanguages: {SubtitleLanguages}",
                extensions != null ? string.Join(", ", extensions) : "null",
                audioLanguages != null ? string.Join(", ", audioLanguages) : "null",
                subtitleLanguages != null ? string.Join(", ", subtitleLanguages) : "null");

            var request = new ProfileDirectoryQueueRequestDto(
                _formModel.DirectoryPath,
                _formModel.OutputDirectory,
                extensions,
                _formModel.Crf,
                _formModel.AudioBitrateKbps,
                _formModel.AudioChannels,
                _formModel.Resolution,
                audioLanguages,
                subtitleLanguages,
                _formModel.OutputFilenameTemplate,
                _formModel.OutputPathTemplate,
                _formModel.VmafEnabled);

            if (!await ValidateAndSetErrorsAsync(ProfileDirectoryQueueValidator, request).ConfigureAwait(false))
            {
                return;
            }

            await OnSubmit.InvokeAsync(request);
            Logger.LogInformation("Form submission completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during form submission");
            throw new InvalidOperationException("Failed to submit directory queue form", ex);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OpenDirectoryBrowser()
    {
        Logger.LogDebug("Opening directory browser dialog");
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        };

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<FileBrowser>
        {
            { x => x.Title, "Select Directory to Queue" },
            { x => x.Mode, FileBrowserMode.Directory },
            { x => x.InitialPath, _formModel.DirectoryPath },
            { x => x.OnPathSelected, EventCallback.Factory.Create<string>(this, (path) =>
            {
                HandleDirectorySelected(path);
                dialogRef?.Close();
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        };

        dialogRef = await DialogService.ShowAsync<FileBrowser>("Select Directory to Queue", parameters, options).ConfigureAwait(false);
    }

    private async Task OpenOutputDirectoryBrowser()
    {
        Logger.LogDebug("Opening output directory browser dialog");
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        };

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<FileBrowser>
        {
            { x => x.Title, "Select Output Directory" },
            { x => x.Mode, FileBrowserMode.Directory },
            { x => x.InitialPath, _formModel.OutputDirectory },
            { x => x.OnPathSelected, EventCallback.Factory.Create<string>(this, (path) =>
            {
                HandleOutputDirectorySelected(path);
                dialogRef?.Close();
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        };

        dialogRef = await DialogService.ShowAsync<FileBrowser>("Select Output Directory", parameters, options).ConfigureAwait(false);
    }

    private void HandleDirectorySelected(string path)
    {
        Logger.LogInformation("Directory selected from browser: {Path}", path);
        _formModel.DirectoryPath = path;
        StateHasChanged();
    }

    private void HandleOutputDirectorySelected(string path)
    {
        Logger.LogInformation("Output directory selected from browser: {Path}", path);
        _formModel.OutputDirectory = path;
        StateHasChanged();
    }

    private async Task HandleCancel()
    {
        Logger.LogDebug("Profile queue directory dialog cancelled");
        await OnCancel.InvokeAsync().ConfigureAwait(false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (EditConversionDialogLogic.ShouldAllowSubmission(e.Key, _isSubmitting, _editForm.EditContext?.Validate() == true))
        {
            Logger.LogDebug("Enter key pressed and form is valid, triggering form submission");
            await HandleValidSubmit();
        }
    }

    private sealed class DirectoryFormModel
    {
        public string DirectoryPath { get; set; } = string.Empty;

        public string OutputDirectory { get; set; } = string.Empty;

        public string? ExtensionsString { get; set; }

        public int? Crf { get; set; }

        public int? AudioBitrateKbps { get; set; }

        public AudioChannels? AudioChannels { get; set; }

        public int? Resolution { get; set; } = ResolutionOptions.Default;

        public string? OutputFilenameTemplate { get; set; }

        public string? OutputPathTemplate { get; set; }

        public string? AudioLanguagesString { get; set; }

        public string? SubtitleLanguagesString { get; set; }

        public bool VmafEnabled { get; set; }
    }
}
