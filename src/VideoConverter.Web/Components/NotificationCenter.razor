@inject IVideoConverterApiClient ApiClient
@inject ILogger<NotificationCenter> Logger

<MudMenu>
    <ActivatorContent>
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit">
            @if (_unreadCount > 0)
            {
                <MudBadge Content="@_unreadCount" Color="Color.Error" Overlap="true">
                </MudBadge>
            }
        </MudIconButton>
    </ActivatorContent>
    <ChildContent>
        <MudPaper Elevation="4" Style="max-height: 500px; overflow-y: auto; width: 400px;">
            <MudStack Spacing="2" Style="padding: 16px;">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.h6">Notifications</MudText>
                    @if (_notifications.Count > 0)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearAllAsync">Clear All</MudButton>
                    }
                </MudStack>
                @if (_isLoading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (_notifications.Count == 0)
                {
                    <MudText Align="Align.Center" Typo="Typo.body2" Style="padding: 32px;">No notifications</MudText>
                }
                else
                {
                    @foreach (var notification in _notifications)
                    {
                        <MudCard Elevation="1">
                            <MudCardContent>
                                <MudStack Spacing="1">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: bold;">@notification.Title</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetColorForType(notification.Type)">@notification.Type</MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.body2">@notification.Message</MudText>
                                    <MudText Typo="Typo.caption" Style="color: gray;">@notification.CreatedAtUtc.ToString("g")</MudText>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    }
                }
            </MudStack>
        </MudPaper>
    </ChildContent>
</MudMenu>

@code {
    private bool _isLoading;
    private List<NotificationDto> _notifications = new();
    private int _unreadCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadNotificationsAsync().ConfigureAwait(false);
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            _isLoading = true;
            StateHasChanged();

            var notifications = await ApiClient.GetNotificationsAsync().ConfigureAwait(false);
            _notifications = notifications.ToList();
            _unreadCount = _notifications.Count(n => !n.IsRead);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading notifications");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ClearAllAsync()
    {
        try
        {
            await ApiClient.ClearNotificationsAsync().ConfigureAwait(false);
            _notifications.Clear();
            _unreadCount = 0;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error clearing notifications");
        }
    }

    private static Color GetColorForType(NotificationType type)
    {
        return type switch
        {
            NotificationType.Success => Color.Success,
            NotificationType.Error => Color.Error,
            NotificationType.Warning => Color.Warning,
            NotificationType.Info => Color.Info,
            _ => Color.Default,
        };
    }
}
