<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Help" Class="mr-2" />
            Template Guide
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3" @bind-ActivePanelIndex="_activePanelIndex">
            <MudTabPanel Text="Filename Template" Icon="@Icons.Material.Filled.InsertDriveFile">
                <MudText Typo="Typo.body2" Class="mb-3">
                    The filename template controls how output files are named based on detected media metadata.
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Available Tokens</MudText>
                <MudSimpleTable Dense="true" Hover="true" Class="mb-4">
                    <thead>
                        <tr>
                            <th>Token</th>
                            <th>Description</th>
                            <th>Example</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>{Title}</code></td>
                            <td>Movie title or TV show name</td>
                            <td>Breaking Bad</td>
                        </tr>
                        <tr>
                            <td><code>{Year}</code></td>
                            <td>Release year (movie) or first aired year (TV)</td>
                            <td>2008</td>
                        </tr>
                        <tr>
                            <td><code>{Season}</code></td>
                            <td>Season number (TV only)</td>
                            <td>1</td>
                        </tr>
                        <tr>
                            <td><code>{Episode}</code></td>
                            <td>Episode number (TV only)</td>
                            <td>5</td>
                        </tr>
                        <tr>
                            <td><code>{EpisodeName}</code></td>
                            <td>Episode title (TV only)</td>
                            <td>Gray Matter</td>
                        </tr>
                        <tr>
                            <td><code>{Source}</code></td>
                            <td>Source tag if detected</td>
                            <td>WEB-DL, HDTV</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Filters</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Apply filters to tokens using the format <code>{Token:filter}</code>
                </MudText>
                <MudSimpleTable Dense="true" Hover="true" Class="mb-4">
                    <thead>
                        <tr>
                            <th>Filter</th>
                            <th>Description</th>
                            <th>Example</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>spaces=dot</code></td>
                            <td>Replace spaces with dots</td>
                            <td><code>{Title:spaces=dot}</code> → Breaking.Bad</td>
                        </tr>
                        <tr>
                            <td><code>spaces=underscore</code></td>
                            <td>Replace spaces with underscores</td>
                            <td><code>{Title:spaces=underscore}</code> → Breaking_Bad</td>
                        </tr>
                        <tr>
                            <td><code>spaces=hyphen</code></td>
                            <td>Replace spaces with hyphens</td>
                            <td><code>{Title:spaces=hyphen}</code> → Breaking-Bad</td>
                        </tr>
                        <tr>
                            <td><code>lower</code></td>
                            <td>Convert to lowercase</td>
                            <td><code>{Title:lower}</code> → breaking bad</td>
                        </tr>
                        <tr>
                            <td><code>upper</code></td>
                            <td>Convert to uppercase</td>
                            <td><code>{Title:upper}</code> → BREAKING BAD</td>
                        </tr>
                        <tr>
                            <td><code>00</code></td>
                            <td>Zero-pad numbers (for Season/Episode)</td>
                            <td><code>{Season:00}</code> → 01</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Smart Collapse</MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    When a token is empty (e.g., <code>{Season}</code> for movies), the token and adjacent separators are automatically removed.
                    For example, <code>S{Season:00}E{Episode:00}</code> disappears entirely for movies.
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Example Templates</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Code">
                        <code>{Title}.{Year}.S{Season:00}E{Episode:00}.{EpisodeName}.{Source}</code>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Full TV format with all metadata</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Code">
                        <code>{Title:spaces=dot}.{Year}</code>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Movie with dot-separated title</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Code">
                        <code>{Title:lower,spaces=underscore}.S{Season:00}E{Episode:00}</code>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Lowercase with underscores</MudText>
                    </MudListItem>
                </MudList>
            </MudTabPanel>

            <MudTabPanel Text="Path Template" Icon="@Icons.Material.Filled.Folder">
                <MudText Typo="Typo.body2" Class="mb-3">
                    The path template creates dynamic directory structures based on media metadata. The rendered path is appended to the output directory.
                </MudText>

                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    In profile editing, the single <strong>Output Path</strong> input maps to the same runtime fields.
                    It sets base <code>outputDirectory</code>, plus optional <code>outputPathTemplate</code> and optional <code>outputFilenameTemplate</code> when template segments are present.
                </MudAlert>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Available Tokens</MudText>
                <MudSimpleTable Dense="true" Hover="true" Class="mb-4">
                    <thead>
                        <tr>
                            <th>Token</th>
                            <th>Description</th>
                            <th>Example</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>{Type}</code></td>
                            <td>Media type</td>
                            <td>Movie, TV</td>
                        </tr>
                        <tr>
                            <td><code>{Title}</code></td>
                            <td>Movie title or TV show name</td>
                            <td>Breaking Bad</td>
                        </tr>
                        <tr>
                            <td><code>{Year}</code></td>
                            <td>Release year (movie) or first aired year (TV)</td>
                            <td>2008</td>
                        </tr>
                        <tr>
                            <td><code>{Season}</code></td>
                            <td>Season number (TV only)</td>
                            <td>1</td>
                        </tr>
                        <tr>
                            <td><code>{Episode}</code></td>
                            <td>Episode number (TV only)</td>
                            <td>5</td>
                        </tr>
                        <tr>
                            <td><code>{EpisodeName}</code></td>
                            <td>Episode title (TV only)</td>
                            <td>Gray Matter</td>
                        </tr>
                        <tr>
                            <td><code>{Source}</code></td>
                            <td>Source tag if detected</td>
                            <td>WEB-DL, HDTV</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Filters</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Same filters as filename templates are available: <code>spaces=</code>, <code>lower</code>, <code>upper</code>, and numeric formatting.
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="mb-2 mt-3">Path Handling</MudText>
                <MudList T="string" Dense="true" Class="mb-3">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">Empty tokens and adjacent path separators are automatically removed</MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">Illegal filesystem characters are replaced with underscores</MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Check">Directory structure is created automatically if it doesn't exist</MudListItem>
                </MudList>

                <MudText Typo="Typo.subtitle2" Class="mb-2">Example Templates</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Code">
                        <code>{Type}/{Title}</code>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Separate by media type (Movie/TV folders)</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Code">
                        <code>{Type}/{Title}/Season {Season:00}</code>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">With season subfolders for TV shows</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Code">
                        <code>Movies/{Title} ({Year})</code>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Custom movie organization with year</MudText>
                    </MudListItem>
                </MudList>

                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    <strong>Example:</strong> With output directory <code>C:/media/out</code> and template <code>{Type}/{Title}/Season {Season:00}</code>,
                    a TV episode would be saved to <code>C:/media/out/TV/Breaking Bad/Season 01/</code>
                </MudAlert>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public TemplateType InitialTab { get; set; } = TemplateType.Filename;

    private int _activePanelIndex;

    protected override void OnInitialized()
    {
        _activePanelIndex = TemplateHelpDialogLogic.GetInitialActivePanelIndex(InitialTab);
    }

    private void Close()
    {
        MudDialog.Close();
    }

    public enum TemplateType
    {
        Filename,
        Path,
    }
}
