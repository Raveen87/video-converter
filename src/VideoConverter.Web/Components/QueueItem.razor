<div class="queue-item @GetCssClasses()"
     draggable="true"
     @ondragstart="HandleDragStart"
     @ondragend="HandleDragEnd"
     @ondragover="@HandleDragOver"
     @ondragover:preventDefault="@true"
     @ondrop="@HandleDrop"
     @ondrop:preventDefault="@true">
    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="queue-item-handle" />
    <div class="queue-item-content">
        @if (!string.IsNullOrEmpty(Item.MatchedTitle))
        {
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.body1" Style="font-weight: 500;">
                    @Item.MatchedTitle
                    @if (Item.MatchedYear.HasValue)
                    {
                        <span class="ml-1">(@Item.MatchedYear)</span>
                    }
                </MudText>
                @if (Item.MatchedSeason.HasValue)
                {
                    <MudText Typo="Typo.body2">S@(Item.MatchedSeason)E@(Item.MatchedEpisode)</MudText>
                }
                @if (Item.TmdbId.HasValue)
                {
                    <MudLink Href="@GetTmdbLink(Item)" Target="_blank" Typo="Typo.caption">TMDb</MudLink>
                }
            </div>
        }
        <MudText Typo="Typo.body2">@Item.InputPath</MudText>
        @if (!string.IsNullOrEmpty(Item.MetadataBasedFilename))
        {
            <MudText Typo="Typo.caption" Color="Color.Primary">Output: @Item.MetadataBasedFilename</MudText>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Item.OutputDirectory</MudText>
    </div>
    @if (OnDelete.HasValue)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="HandleDelete" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="queue-item-delete" />
    }
</div>

@code {
    [Parameter]
    public ConversionDto Item { get; set; } = null!;

    [Parameter]
    public EventCallback<int> OnDragStart { get; set; }

    [Parameter]
    public EventCallback OnDragEnd { get; set; }

    [Parameter]
    public EventCallback<DragEventArgs>? OnDragOver { get; set; }

    [Parameter]
    public EventCallback<DragEventArgs>? OnDrop { get; set; }

    [Parameter]
    public EventCallback<int>? OnDelete { get; set; }

    [Parameter]
    public bool IsDragging { get; set; }

    [Parameter]
    public bool IsDragOver { get; set; }

    [Parameter]
    public string? DragOverPosition { get; set; }

    private string GetCssClasses()
    {
        var classes = new List<string>();

        if (IsDragging)
        {
            classes.Add("queue-item-dragging");
        }

        if (IsDragOver)
        {
            classes.Add("queue-item-drag-over");
            if (!string.IsNullOrEmpty(DragOverPosition))
            {
                classes.Add($"queue-item-drag-over-{DragOverPosition}");
            }
        }

        return string.Join(" ", classes);
    }

    private void HandleDragStart(DragEventArgs e)
    {
        OnDragStart.InvokeAsync(Item.Id);
    }

    private void HandleDragEnd(DragEventArgs e)
    {
        OnDragEnd.InvokeAsync();
    }

    private void HandleDragOver(DragEventArgs e)
    {
        if (OnDragOver.HasValue)
        {
            OnDragOver.Value.InvokeAsync(e);
        }
    }

    private void HandleDrop(DragEventArgs e)
    {
        if (OnDrop.HasValue)
        {
            OnDrop.Value.InvokeAsync(e);
        }
    }

    private void HandleDelete()
    {
        if (OnDelete.HasValue)
        {
            OnDelete.Value.InvokeAsync(Item.Id);
        }
    }

    private static string GetTmdbLink(ConversionDto item)
    {
        if (item.MatchedSeason.HasValue)
        {
            return $"https://www.themoviedb.org/tv/{item.TmdbId}";
        }
        return $"https://www.themoviedb.org/movie/{item.TmdbId}";
    }
}

