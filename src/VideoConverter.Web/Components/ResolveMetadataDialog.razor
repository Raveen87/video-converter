<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@GetTitle()</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mb-2">
                    Search for the correct metadata for: <strong>@GetSourceFileName()</strong>
                </MudText>
                @if (GetInputKind() != "Unknown")
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="mb-2">@GetInputKind()</MudChip>
                }
            </MudItem>
            <MudItem xs="8">
                <MudTextField @bind-Value="_searchQuery" Label="Search Query" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="SearchAsync" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField @bind-Value="_searchYear" Label="Year (Optional)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync" Disabled="@_isSearching" FullWidth="true">
                    @if (_isSearching)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <text>Searching...</text>
                    }
                    else
                    {
                        <text>Search</text>
                    }
                </MudButton>
            </MudItem>
        </MudGrid>

        @if (_searchResults != null)
        {
            <MudList T="MetadataSearchResultDto" SelectionMode="SelectionMode.SingleSelection" SelectedValue="_selectedResult" SelectedValueChanged="OnResultSelected" Class="mt-4" Style="max-height: 400px; overflow-y: auto;">
                @if (!_searchResults.Any())
                {
                    <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">No results found.</MudText>
                }
                @foreach (var result in _searchResults)
                {
                    <MudListItem Value="@result">
                        <div class="d-flex gap-4">
                            @if (!string.IsNullOrEmpty(result.PosterUrl))
                            {
                                <MudImage Src="@result.PosterUrl" Height="100" Width="67" ObjectFit="ObjectFit.Cover" Elevation="2" Class="rounded" />
                            }
                            else
                            {
                                <div class="d-flex justify-center align-center rounded bg-dark" style="height: 100px; width: 67px;">
                                    <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" />
                                </div>
                            }
                            <div>
                                <MudText Typo="Typo.subtitle1"><b>@result.Title</b> (@(result.Year?.ToString() ?? "N/A"))</MudText>
                                <MudText Typo="Typo.caption">@result.Type</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1" Style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                    @result.Overview
                                </MudText>
                            </div>
                        </div>
                    </MudListItem>
                    <MudDivider />
                }
            </MudList>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isResolving">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="ResolveAsync" Disabled="@(_selectedResult == null || _isResolving)">
             @if (_isResolving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <text>Resolving...</text>
            }
            else
            {
                <text>@GetButtonText()</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@using VideoConverter.Common.Models
@using VideoConverter.Web.Services
@using MudBlazor

@code {
    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    [Parameter]
    public ManualResolutionQueueItemDto? ManualResolutionItem { get; set; }

    [Parameter]
    public ConversionDto? Conversion { get; set; }

    [Parameter]
    public IReadOnlyList<ConversionDto>? Conversions { get; set; }

    [Parameter]
    public IReadOnlyList<ManualResolutionQueueItemDto>? ManualResolutionItems { get; set; }

    [Inject]
    private IVideoConverterApiClient ApiClient { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    private string _searchQuery = string.Empty;
    private int? _searchYear;
    private bool _isSearching;
    private bool _isResolving;
    private List<MetadataSearchResultDto>? _searchResults;
    private MetadataSearchResultDto? _selectedResult;

    protected override void OnInitialized()
    {
        if (ManualResolutionItem != null)
        {
            _searchQuery = ManualResolutionItem.ParsedTitle ?? Path.GetFileNameWithoutExtension(ManualResolutionItem.SourceFileName) ?? string.Empty;
            _searchYear = ManualResolutionItem.ParsedYear;
        }
        else if (Conversion != null)
        {
            _searchQuery = Conversion.MatchedTitle ?? Path.GetFileNameWithoutExtension(Conversion.InputPath) ?? string.Empty;
            _searchYear = Conversion.MatchedYear;
        }
        else if (Conversions is { Count: > 0 })
        {
            var first = Conversions[0];
            _searchQuery = first.MatchedTitle ?? Path.GetFileNameWithoutExtension(first.InputPath) ?? string.Empty;
            _searchYear = first.MatchedYear;
        }
        else if (ManualResolutionItems is { Count: > 0 })
        {
            var first = ManualResolutionItems[0];
            _searchQuery = first.ParsedTitle ?? Path.GetFileNameWithoutExtension(first.SourceFileName) ?? string.Empty;
            _searchYear = first.ParsedYear;
        }
    }

    private string GetTitle()
    {
        if (Conversions is { Count: > 1 }) return $"Resolve Metadata ({Conversions.Count} items)";
        if (ManualResolutionItems is { Count: > 1 }) return $"Resolve Metadata ({ManualResolutionItems.Count} items)";
        return "Resolve Metadata";
    }

    private string GetSourceFileName()
    {
        if (ManualResolutionItem != null) return ManualResolutionItem.SourceFileName ?? string.Empty;
        if (Conversion != null) return Path.GetFileName(Conversion.InputPath) ?? string.Empty;
        if (Conversions is { Count: > 0 })
        {
            if (Conversions.Count == 1) return Path.GetFileName(Conversions[0].InputPath) ?? string.Empty;
            return $"{Conversions.Count} items";
        }
        if (ManualResolutionItems is { Count: > 0 })
        {
            if (ManualResolutionItems.Count == 1) return ManualResolutionItems[0].SourceFileName ?? string.Empty;
            return $"{ManualResolutionItems.Count} items";
        }
        return string.Empty;
    }

    private string GetInputKind()
    {
         if (ManualResolutionItem != null) return ManualResolutionItem.InputKind;
         if (ManualResolutionItems is { Count: > 0 }) return ManualResolutionItems[0].InputKind;
         return "Unknown";
    }

    private string GetButtonText()
    {
        if (ManualResolutionItem != null) return "Resolve & Create";
        if (Conversions is { Count: > 1 }) return "Update All";
        if (ManualResolutionItems is { Count: > 1 }) return "Resolve All";
        return "Update Metadata";
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            return;
        }

        _isSearching = true;
        _searchResults = null;
        _selectedResult = null;

        try
        {
            // Determine type based on input kind or default
            MediaType? type = null;
            var inputKind = GetInputKind();
            if (Enum.TryParse<MediaType>(inputKind, out var parsedType))
            {
                type = parsedType;
            }

            var request = new MetadataSearchRequestDto
            {
                Query = _searchQuery,
                Year = _searchYear,
                Type = type
            };

            var results = await ApiClient.SearchMetadataAsync(request);
            _searchResults = results.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error searching metadata: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSearching = false;
        }
    }

    private void OnResultSelected(MetadataSearchResultDto? result)
    {
        _selectedResult = result;
    }

    private async Task ResolveAsync()
    {
        if (_selectedResult == null) return;

        _isResolving = true;
        try
        {
            var request = new ResolveMetadataRequestDto
            {
                TmdbId = _selectedResult.Id,
                MediaType = _selectedResult.Type
            };

            if (ManualResolutionItem != null)
            {
                await ApiClient.ResolveMetadataQueueItemAsync(ManualResolutionItem.Id, request);
            }
            else if (Conversion != null)
            {
                await ApiClient.ResolveConversionMetadataAsync(Conversion.Id, request);
            }
            else if (Conversions is { Count: > 0 })
            {
                 var batchRequest = new ResolveBatchMetadataRequestDto
                 {
                     ConversionIds = Conversions.Select(c => c.Id).ToList(),
                     TmdbId = _selectedResult.Id,
                     MediaType = _selectedResult.Type
                 };
                 await ApiClient.ResolveBatchConversionMetadataAsync(batchRequest);
            }
            else if (ManualResolutionItems is { Count: > 0 })
            {
                var batchRequest = new ResolveBatchMetadataQueueRequestDto
                {
                    QueueItemIds = ManualResolutionItems.Select(q => q.Id).ToList(),
                    TmdbId = _selectedResult.Id,
                    MediaType = _selectedResult.Type
                };
                await ApiClient.ResolveBatchMetadataQueueItemsAsync(batchRequest);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error resolving item: {ex.Message}", Severity.Error);
            _isResolving = false;
            return;
        }

        // Operation succeeded, signal close
        await OnClose.InvokeAsync(true);
    }

    private async Task Cancel() => await OnClose.InvokeAsync(false);
}
