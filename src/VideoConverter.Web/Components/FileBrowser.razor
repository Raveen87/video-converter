@using VideoConverter.Common.Models
@using VideoConverter.Web.Models
@using VideoConverter.Web.Services
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <div @onkeydown="HandleKeyDown">
        @if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => LoadDirectoryAsync())">Retry</MudButton>
        }
        else
        {
            <div class="file-browser-container">
                @if (_currentPath is not null)
                {
                    <div class="mb-3">
                        <MudBreadcrumbs Items="@_mudBreadcrumbs" MaxItems="5" Separator="/">
                            <ItemTemplate>
                                <MudLink OnClick="@(() => NavigateToPath(context.Href ?? string.Empty))" Underline="Underline.Hover" Style="cursor: pointer;">@context.Text</MudLink>
                            </ItemTemplate>
                        </MudBreadcrumbs>
                    </div>
                }

                @if (_parentPath is not null)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowUpward" OnClick="@(() => NavigateToPath(_parentPath))" Class="mb-2">
                        Parent Directory
                    </MudButton>
                }

                @if (_isLoading)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
                    <MudText>Loading directory contents...</MudText>
                }
                else
                {
                    <MudPaper Class="pa-2" Style="max-height: 400px; overflow-y: auto;">
                        @if (_directories.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Directories</MudText>
                            <MudList T="string" Dense="true">
                                @foreach (var dir in _directories)
                                {
                                    <MudListItem T="string" Value="@dir.Path" OnClick="@(() => HandleDirectoryClick(dir.Path))" @ondblclick="@(() => HandleDirectoryDoubleClick(dir.Path))" Class="@(IsDirectorySelected(dir.Path) ? "selected-file" : "")">
                                        <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-2" />
                                        <MudText>@dir.Name</MudText>
                                    </MudListItem>
                                }
                            </MudList>
                        }

                        @if (_files.Count > 0)
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">Files</MudText>
                            <MudList T="string" Dense="true">
                                @foreach (var file in _files)
                                {
                                    <MudListItem T="string" Value="@file.Path" OnClick="@(() => SelectFile(file.Path))" Class="@(IsFileSelected(file.Path) ? "selected-file" : "")">
                                        <MudIcon Icon="@Icons.Material.Filled.VideoFile" Class="mr-2" />
                                        <div class="d-flex flex-column">
                                            <MudText>@file.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @FormatFileSize(file.Size) • @file.LastModified.ToString("yyyy-MM-dd HH:mm")
                                            </MudText>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }

                        @if (_directories.Count == 0 && _files.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No items found</MudText>
                        }
                    </MudPaper>
                }

                @if (_selectedPath is not null)
                {
                    <MudTextField @bind-Value="_selectedPath" Label="Selected Path" Variant="Variant.Outlined" ReadOnly="true" Class="mt-3" />
                }
            </div>
        }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="HandleCancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSelect" Disabled="@(_selectedPath is null || _isLoading)">
            Select
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public string Title { get; set; } = "Select File or Directory";

    [Parameter]
    public FileBrowserMode Mode { get; set; } = FileBrowserMode.File;

    [Parameter]
    public string? InitialPath { get; set; }

    [Parameter]
    public EventCallback<string> OnPathSelected { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Inject]
    private IFileBrowserService FileBrowserService { get; set; } = null!;

    [Inject]
    private ILogger<FileBrowser> Logger { get; set; } = null!;

    private string? _currentPath;
    private string? _parentPath;
    private string? _selectedPath;
    private List<DirectoryItemDto> _directories = new();
    private List<FileItemDto> _files = new();
    private List<BreadcrumbItem> _mudBreadcrumbs = new();
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("FileBrowser component initializing. Mode: {Mode}, InitialPath: {InitialPath}", Mode, InitialPath);
        await LoadDirectoryAsync(InitialPath).ConfigureAwait(false);
    }

    private async Task LoadDirectoryAsync(string? path = null)
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            Logger.LogDebug("Loading directory contents for path: {Path}", path ?? "(root)");
            var response = await FileBrowserService.GetDirectoryContentsAsync(path).ConfigureAwait(false);

            _currentPath = response.CurrentPath;
            _parentPath = response.ParentPath;
            _directories = response.Directories.ToList();
            _files = response.Files.ToList();

            _mudBreadcrumbs = BuildBreadcrumbs(_currentPath);

            if (Mode == FileBrowserMode.Directory)
            {
                _selectedPath = _currentPath;
            }
            else if (Mode == FileBrowserMode.FileOrDirectory)
            {
                // In FileOrDirectory mode, don't auto-select the current directory
                // User must explicitly select a file or directory
                _selectedPath = null;
            }

            Logger.LogInformation(
                "Loaded directory contents. Path: {Path}, Directories: {DirCount}, Files: {FileCount}",
                _currentPath,
                _directories.Count,
                _files.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading directory contents for path: {Path}", path);
            _errorMessage = $"Failed to load directory contents: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task NavigateToPath(string path)
    {
        Logger.LogDebug("Navigating to path: {Path}", path);
        await LoadDirectoryAsync(path).ConfigureAwait(false);
    }

    private async Task HandleDirectoryClick(string path)
    {
        Logger.LogDebug("Directory clicked: {Path}, Mode: {Mode}", path, Mode);
        if (Mode == FileBrowserMode.Directory)
        {
            _selectedPath = path;
            StateHasChanged();
            await NavigateToPath(path).ConfigureAwait(false);
        }
        else if (Mode == FileBrowserMode.FileOrDirectory)
        {
            // In FileOrDirectory mode, single-click selects the directory
            _selectedPath = path;
            StateHasChanged();
        }
        else
        {
            // In File mode, just navigate into the directory
            await NavigateToPath(path).ConfigureAwait(false);
        }
    }

    private async Task HandleDirectoryDoubleClick(string path)
    {
        Logger.LogDebug("Directory double-clicked: {Path}, Mode: {Mode}", path, Mode);
        if (Mode == FileBrowserMode.FileOrDirectory)
        {
            // In FileOrDirectory mode, double-click navigates into the directory
            await NavigateToPath(path).ConfigureAwait(false);
        }
    }

    private void SelectFile(string path)
    {
        Logger.LogDebug("File selected: {Path}", path);
        if (Mode == FileBrowserMode.File || Mode == FileBrowserMode.FileOrDirectory)
        {
            _selectedPath = path;
            StateHasChanged();
        }
    }

    private bool IsDirectorySelected(string path)
    {
        return (Mode == FileBrowserMode.Directory || Mode == FileBrowserMode.FileOrDirectory)
               && _selectedPath == path;
    }

    private bool IsFileSelected(string path)
    {
        return (Mode == FileBrowserMode.File || Mode == FileBrowserMode.FileOrDirectory)
               && _selectedPath == path;
    }

    private async Task HandleCancel()
    {
        Logger.LogDebug("File browser dialog cancelled");
        await OnCancel.InvokeAsync().ConfigureAwait(false);
    }

    private async Task HandleSelect()
    {
        if (_selectedPath is null)
        {
            return;
        }

        Logger.LogInformation("Path selected: {Path}", _selectedPath);
        await OnPathSelected.InvokeAsync(_selectedPath).ConfigureAwait(false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (EditConversionDialogLogic.ShouldTriggerSubmit(e.Key, _isLoading) && _selectedPath is not null)
        {
            Logger.LogDebug("Enter key pressed, triggering selection");
            await HandleSelect();
        }
    }

    private static List<BreadcrumbItem> BuildBreadcrumbs(string? path)
    {
        var breadcrumbs = new List<BreadcrumbItem>();

        if (string.IsNullOrWhiteSpace(path))
        {
            breadcrumbs.Add(new BreadcrumbItem("Root", "/", disabled: false));
            return breadcrumbs;
        }

        // Handle both forward and backward slashes for splitting
        var parts = path.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar, '/', '\\' }, StringSplitOptions.RemoveEmptyEntries);
        
        // Check if path looks like a Windows path (starts with drive letter)
        // e.g., "C:", "C:\", "C:/", etc.
        var isWindowsPath = parts.Length > 0 && parts[0].Length == 2 && parts[0][1] == ':';

        string currentPath;

        if (isWindowsPath)
        {
            // Windows path logic (regardless of OS)
            // The first part is the drive letter (e.g. "C:")
            var drive = parts[0];
            
            // On Windows backend, the root is "C:\". 
            // If we just use "C:", Path.Combine might produce "C:Users" (relative) depending on implementation.
            // We want "C:\" or "C:/" as the base.
            // However, we must be careful not to introduce double separators.
            
            // For the first breadcrumb (the drive), the path should be the drive root.
            var driveRoot = drive + Path.DirectorySeparatorChar; 
            if (!driveRoot.EndsWith('\\') && !driveRoot.EndsWith('/'))
            {
                 driveRoot += "\\"; // Default to backslash for Windows paths if separator is weird
            }
            
            breadcrumbs.Add(new BreadcrumbItem(drive, driveRoot, disabled: false));
            
            currentPath = driveRoot;
            parts = parts.Skip(1).ToArray();
        }
        else
        {
            // Unix/Rooted path logic
            breadcrumbs.Add(new BreadcrumbItem("Root", "/", disabled: false));
            currentPath = "/";
        }

        foreach (var part in parts)
        {
            // Use Path.Combine, but ensure we don't double up if currentPath already ends with separator
            // Or just manually join to be safe and consistent.
            if (isWindowsPath)
            {
                // For Windows paths, prefer backslash
                var separator = '\\';
                currentPath = currentPath.TrimEnd(separator) + separator + part;
            }
            else
            {
                // For Unix paths, prefer forward slash
                var separator = '/';
                currentPath = currentPath.TrimEnd(separator) + separator + part;
            }
            
            breadcrumbs.Add(new BreadcrumbItem(part, currentPath, disabled: false));
        }

        return breadcrumbs;
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        var order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }
}
