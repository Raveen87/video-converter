@using VideoConverter.Web.Models
@using VideoConverter.Web.Services
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            <MudText>Loading directory contents...</MudText>
        }
        else if (_errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => LoadDirectoryAsync())">Retry</MudButton>
        }
        else
        {
            <div class="file-browser-container">
                @if (_currentPath is not null)
                {
                    <div class="mb-3">
                        <MudBreadcrumbs Items="@_mudBreadcrumbs" MaxItems="5" Separator="/">
                            <ItemTemplate>
                                <MudLink Href="#" OnClick="@(() => NavigateToPath(context.Href ?? string.Empty))">@context.Text</MudLink>
                            </ItemTemplate>
                        </MudBreadcrumbs>
                    </div>
                }

                @if (_parentPath is not null)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowUpward" OnClick="@(() => NavigateToPath(_parentPath))" Class="mb-2">
                        Parent Directory
                    </MudButton>
                }

                <MudPaper Class="pa-2" Style="max-height: 400px; overflow-y: auto;">
                    @if (_directories.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Directories</MudText>
                        <MudList T="string" Dense="true">
                            @foreach (var dir in _directories)
                            {
                                <MudListItem T="string" Value="@dir.Path" OnClick="@(() => HandleDirectoryClick(dir.Path))" Class="@(Mode == FileBrowserMode.Directory && _selectedPath == dir.Path ? "selected-file" : "")">
                                    <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-2" />
                                    <MudText>@dir.Name</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    @if (_files.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2 mt-4">Files</MudText>
                        <MudList T="string" Dense="true">
                            @foreach (var file in _files)
                            {
                                <MudListItem T="string" Value="@file.Path" OnClick="@(() => SelectFile(file.Path))" Class="@(Mode == FileBrowserMode.File && _selectedPath == file.Path ? "selected-file" : "")">
                                    <MudIcon Icon="@Icons.Material.Filled.VideoFile" Class="mr-2" />
                                    <div class="d-flex flex-column">
                                        <MudText>@file.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @FormatFileSize(file.Size) • @file.LastModified.ToString("yyyy-MM-dd HH:mm")
                                        </MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    @if (_directories.Count == 0 && _files.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No items found</MudText>
                    }
                </MudPaper>

                @if (_selectedPath is not null)
                {
                    <MudTextField @bind-Value="_selectedPath" Label="Selected Path" Variant="Variant.Outlined" ReadOnly="true" Class="mt-3" />
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="HandleCancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSelect" Disabled="@(_selectedPath is null || _isLoading)">
            Select
        </MudButton>
    </DialogActions>
</MudDialog>

@code {

    [Parameter]
    public string Title { get; set; } = "Select File or Directory";

    [Parameter]
    public FileBrowserMode Mode { get; set; } = FileBrowserMode.File;

    [Parameter]
    public string? InitialPath { get; set; }

    [Parameter]
    public EventCallback<string> OnPathSelected { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Inject]
    private IFileBrowserService FileBrowserService { get; set; } = null!;

    [Inject]
    private ILogger<FileBrowser> Logger { get; set; } = null!;

    private string? _currentPath;
    private string? _parentPath;
    private string? _selectedPath;
    private List<DirectoryItemDto> _directories = new();
    private List<FileItemDto> _files = new();
    private List<BreadcrumbItem> _mudBreadcrumbs = new();
    private bool _isLoading;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("FileBrowser component initializing. Mode: {Mode}, InitialPath: {InitialPath}", Mode, InitialPath);
        await LoadDirectoryAsync(InitialPath).ConfigureAwait(false);
    }

    private async Task LoadDirectoryAsync(string? path = null)
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            Logger.LogDebug("Loading directory contents for path: {Path}", path ?? "(root)");
            var response = await FileBrowserService.GetDirectoryContentsAsync(path).ConfigureAwait(false);

            _currentPath = response.CurrentPath;
            _parentPath = response.ParentPath;
            _directories = response.Directories.ToList();
            _files = response.Files.ToList();

            _mudBreadcrumbs = BuildBreadcrumbs(_currentPath);

            if (Mode == FileBrowserMode.Directory)
            {
                _selectedPath = _currentPath;
            }

            Logger.LogInformation(
                "Loaded directory contents. Path: {Path}, Directories: {DirCount}, Files: {FileCount}",
                _currentPath,
                _directories.Count,
                _files.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading directory contents for path: {Path}", path);
            _errorMessage = $"Failed to load directory contents: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task NavigateToPath(string path)
    {
        Logger.LogDebug("Navigating to path: {Path}", path);
        await LoadDirectoryAsync(path).ConfigureAwait(false);
    }

    private async Task HandleDirectoryClick(string path)
    {
        Logger.LogDebug("Directory clicked: {Path}, Mode: {Mode}", path, Mode);
        if (Mode == FileBrowserMode.Directory)
        {
            _selectedPath = path;
            StateHasChanged();
        }

        await NavigateToPath(path).ConfigureAwait(false);
    }

    private void SelectFile(string path)
    {
        Logger.LogDebug("File selected: {Path}", path);
        _selectedPath = path;
        StateHasChanged();
    }

    private async Task HandleCancel()
    {
        Logger.LogDebug("File browser dialog cancelled");
        await OnCancel.InvokeAsync().ConfigureAwait(false);
    }

    private async Task HandleSelect()
    {
        if (_selectedPath is null)
        {
            return;
        }

        Logger.LogInformation("Path selected: {Path}", _selectedPath);
        await OnPathSelected.InvokeAsync(_selectedPath).ConfigureAwait(false);
    }

    private static List<BreadcrumbItem> BuildBreadcrumbs(string? path)
    {
        var breadcrumbs = new List<BreadcrumbItem>();

        if (string.IsNullOrWhiteSpace(path))
        {
            breadcrumbs.Add(new BreadcrumbItem("Root", "/", disabled: false));
            return breadcrumbs;
        }

        var parts = path.Split(Path.DirectorySeparatorChar, StringSplitOptions.RemoveEmptyEntries);

        if (OperatingSystem.IsWindows())
        {
            if (path.Length >= 2 && path[1] == ':')
            {
                breadcrumbs.Add(new BreadcrumbItem(path.Substring(0, 2), path.Substring(0, 2), disabled: false));
                parts = parts.Skip(1).ToArray();
            }
        }
        else
        {
            breadcrumbs.Add(new BreadcrumbItem("Root", "/", disabled: false));
        }

        var currentPath = OperatingSystem.IsWindows() && path.Length >= 2 && path[1] == ':'
            ? path.Substring(0, 2)
            : "/";

        foreach (var part in parts)
        {
            currentPath = Path.Combine(currentPath, part);
            breadcrumbs.Add(new BreadcrumbItem(part, currentPath, disabled: false));
        }

        return breadcrumbs;
    }

    private static string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        var order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }
}
