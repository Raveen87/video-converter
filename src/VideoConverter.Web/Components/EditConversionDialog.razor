<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Conversion</MudText>
    </TitleContent>
    <DialogContent>
        <div @onkeydown="HandleFormKeyDown">
            <EditForm Model="@_formModel" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                @if (_validationErrors is not null && _validationErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">
                        <ul class="mb-0">
                            @foreach (var kvp in _validationErrors)
                            {
                                foreach (var message in kvp.Value)
                                {
                                    <li><strong>@kvp.Key:</strong> @message</li>
                                }
                            }
                        </ul>
                    </MudAlert>
                }
                <div class="d-flex align-center mb-3">
                    <MudTextField @bind-Value="_formModel.OutputDirectory" Label="Output Directory" Required="true" Variant="Variant.Outlined" Class="flex-grow-1" />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenDirectoryBrowser" Class="ml-2" Style="height: 56px;">
                        Browse
                    </MudButton>
                </div>
                <MudNumericField @bind-Value="_formModel.Crf" Label="CRF (Quality)" HelperText="Lower is higher quality (18-28 recommended)" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField @bind-Value="_formModel.AudioBitrateKbps" Label="Audio Bitrate (Kbps)" Variant="Variant.Outlined" Class="mb-3" />
                <MudSelect T="AudioChannels?" @bind-Value="_formModel.AudioChannels" Label="Audio Channels" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem T="AudioChannels?" Value="@((AudioChannels?)null)">Default</MudSelectItem>
                    <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Stereo20">Stereo 2.0</MudSelectItem>
                    <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Surround51">Surround 5.1</MudSelectItem>
                </MudSelect>
                <MudNumericField @bind-Value="_formModel.Resolution" Label="Resolution (p)" HelperText="e.g., 1080, 720" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_formModel.OutputFilenameTemplate" Label="Output Filename Template" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_formModel.AudioLanguagesString" Label="Audio Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
                <MudTextField @bind-Value="_formModel.SubtitleLanguagesString" Label="Subtitle Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
                <MudSwitch @bind-Value="_formModel.VmafEnabled" Label="Enable VMAF Quality Scoring" Color="Color.Primary" Class="mb-3" />
                @if (_formModel.VmafEnabled)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        VMAF will calculate a quality score (0-100) after conversion completes by comparing the output to the source.
                    </MudAlert>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <text>Updating...</text>
                    }
                    else
                    {
                        <text>Update</text>
                    }
                </MudButton>
                <MudButton Variant="Variant.Text" Disabled="@_isSubmitting" OnClick="HandleCancel">Cancel</MudButton>
            </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@using VideoConverter.Common.Models
@using VideoConverter.Common.Validation
@using VideoConverter.Web.Models

@code {
    [CascadingParameter]
    public IDialogReference MudDialog { get; set; } = default!;

    [Parameter]
    public ConversionDto Conversion { get; set; } = default!;

    [Parameter]
    public EventCallback<ConversionPatchDto> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Inject]
    private ILogger<EditConversionDialog> Logger { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private IRequestValidator<ConversionPatchDto> ConversionPatchValidator { get; set; } = null!;

    private readonly ConversionFormModel _formModel = new();
    private bool _isSubmitting;
    private Dictionary<string, string[]>? _validationErrors;

    protected override void OnInitialized()
    {
        Logger.LogDebug("EditConversionDialog initializing for conversion {ConversionId}", Conversion.Id);
        _formModel.OutputDirectory = Conversion.OutputDirectory;
        _formModel.Crf = Conversion.Crf;
        _formModel.AudioBitrateKbps = Conversion.AudioBitrateKbps;
        // Map backend AudioChannels enum to frontend enum (they have the same values)
        // Use string-based conversion to avoid type casting issues
        if (Conversion.AudioChannels.HasValue)
        {
            var enumString = Conversion.AudioChannels.Value.ToString();
            if (Enum.TryParse<AudioChannels>(enumString, out var audioChannels))
            {
                _formModel.AudioChannels = audioChannels;
            }
            else
            {
                Logger.LogWarning("Could not parse AudioChannels value: {Value}", enumString);
                _formModel.AudioChannels = null;
            }
        }
        else
        {
            _formModel.AudioChannels = null;
        }

        _formModel.Resolution = Conversion.Resolution;
        _formModel.OutputFilenameTemplate = null; // We don't store the template, only the MetadataBasedFilename result
        _formModel.AudioLanguagesString = null; // Cannot restore from entity
        _formModel.SubtitleLanguagesString = null; // Cannot restore from entity
        _formModel.VmafEnabled = Conversion.VmafEnabled;
    }

    private async Task HandleValidSubmit()
    {
        Logger.LogInformation("Form submission started for conversion {ConversionId}. Output: {OutputDirectory}", 
            Conversion.Id, _formModel.OutputDirectory);
        _isSubmitting = true;
        try
        {
            // Convert string fields back to proper types
            IReadOnlyList<string>? audioLanguages = null;
            IReadOnlyList<string>? subtitleLanguages = null;

            if (!string.IsNullOrWhiteSpace(_formModel.AudioLanguagesString))
            {
                audioLanguages = _formModel.AudioLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            }

            if (!string.IsNullOrWhiteSpace(_formModel.SubtitleLanguagesString))
            {
                subtitleLanguages = _formModel.SubtitleLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            }

            Logger.LogDebug("Form data converted. AudioChannels: {AudioChannels}, AudioLanguages: {AudioLanguages}, SubtitleLanguages: {SubtitleLanguages}", 
                _formModel.AudioChannels, audioLanguages != null ? string.Join(", ", audioLanguages) : "null", 
                subtitleLanguages != null ? string.Join(", ", subtitleLanguages) : "null");

            var patch = new ConversionPatchDto
            {
                OutputDirectory = _formModel.OutputDirectory,
                Crf = _formModel.Crf,
                AudioBitrateKbps = _formModel.AudioBitrateKbps,
                AudioChannels = _formModel.AudioChannels,
                Resolution = _formModel.Resolution,
                OutputFilenameTemplate = _formModel.OutputFilenameTemplate,
                AudioLanguages = audioLanguages,
                SubtitleLanguages = subtitleLanguages,
                VmafEnabled = _formModel.VmafEnabled,
            };

            var validation = await ConversionPatchValidator.ValidateAsync(patch, CancellationToken.None).ConfigureAwait(false);
            if (!validation.IsValid)
            {
                _validationErrors = validation.ToDictionary().ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
                return;
            }

            _validationErrors = null;
            await OnSubmit.InvokeAsync(patch);
            Logger.LogInformation("Form submission completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during form submission");
            throw new InvalidOperationException("Failed to submit conversion form", ex);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OpenDirectoryBrowser()
    {
        Logger.LogDebug("Opening directory browser dialog");
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        };

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<FileBrowser>
        {
            { x => x.Title, "Select Output Directory" },
            { x => x.Mode, FileBrowserMode.Directory },
            { x => x.InitialPath, _formModel.OutputDirectory },
            { x => x.OnPathSelected, EventCallback.Factory.Create<string>(this, (path) =>
            {
                HandleDirectorySelected(path);
                dialogRef?.Close();
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        };

        dialogRef = await DialogService.ShowAsync<FileBrowser>("Select Output Directory", parameters, options).ConfigureAwait(false);
    }

    private void HandleDirectorySelected(string path)
    {
        Logger.LogInformation("Directory selected from browser: {Path}", path);
        _formModel.OutputDirectory = path;
        StateHasChanged();
    }

    private async Task HandleCancel()
    {
        Logger.LogDebug("Edit conversion dialog cancelled");
        await OnCancel.InvokeAsync().ConfigureAwait(false);
    }

    private async Task HandleFormKeyDown(KeyboardEventArgs e)
    {
        if (EditConversionDialogLogic.ShouldTriggerSubmit(e.Key, _isSubmitting))
        {
            Logger.LogDebug("Enter key pressed, triggering form submission");
            await HandleValidSubmit();
        }
    }

    private sealed class ConversionFormModel
    {
        public string OutputDirectory { get; set; } = string.Empty;

        public int? Crf { get; set; }

        public int? AudioBitrateKbps { get; set; }

        public AudioChannels? AudioChannels { get; set; }

        public int? Resolution { get; set; }

        public string? OutputFilenameTemplate { get; set; }

        public string? AudioLanguagesString { get; set; }

        public string? SubtitleLanguagesString { get; set; }

        public bool VmafEnabled { get; set; }
    }
}
