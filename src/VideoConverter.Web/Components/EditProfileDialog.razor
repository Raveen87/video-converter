@using System
@using System.Collections.Generic
@using System.Linq
@using VideoConverter.Common.Validation


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Profile</MudText>
    </TitleContent>
    <DialogContent>
        <div @onkeydown="HandleKeyDown">
            <EditForm @ref="_editForm" Model="@_formModel" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            @if (_validationErrors is not null && _validationErrors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">
                    <ul class="mb-0">
                        @foreach (var kvp in _validationErrors)
                        {
                            foreach (var message in kvp.Value)
                            {
                                <li><strong>@kvp.Key:</strong> @message</li>
                            }
                        }
                    </ul>
                </MudAlert>
            }
            <MudTextField @bind-Value="_formModel.Name" Label="Name" Required="true" Variant="Variant.Outlined" Class="mb-3" />
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.OutputDirectory" Label="Output Directory" Variant="Variant.Outlined" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenDirectoryBrowser" Class="ml-2" Style="height: 56px;">
                    Browse
                </MudButton>
            </div>
            <MudNumericField @bind-Value="_formModel.Crf" Label="CRF (Quality)" HelperText="Lower is higher quality (18-28 recommended)" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_formModel.AudioBitrateKbps" Label="Audio Bitrate (Kbps)" Variant="Variant.Outlined" Class="mb-3" />
            <MudSelect T="AudioChannels?" @bind-Value="_formModel.AudioChannels" Label="Audio Channels" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="AudioChannels?" Value="@((AudioChannels?)null)">Keep source</MudSelectItem>
                <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Stereo20">Stereo 2.0</MudSelectItem>
                <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Surround51">Surround 5.1</MudSelectItem>
            </MudSelect>
            <MudNumericField @bind-Value="_formModel.Resolution" Label="Resolution (p)" HelperText="e.g., 1080, 720" Variant="Variant.Outlined" Class="mb-3" />
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.OutputFilenameTemplate" Label="Output Filename Template" Variant="Variant.Outlined" Class="flex-grow-1" />
                <TemplateHelpButton TemplateType="TemplateHelpDialog.TemplateType.Filename" Class="ml-1" />
            </div>
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.OutputPathTemplate" Label="Output Path Template" HelperText="e.g., {Type}/{Title}/Season {Season:00}" Variant="Variant.Outlined" Class="flex-grow-1" />
                <TemplateHelpButton TemplateType="TemplateHelpDialog.TemplateType.Path" Class="ml-1" />
            </div>
            <MudTextField @bind-Value="_formModel.AudioLanguagesString" Label="Audio Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_formModel.SubtitleLanguagesString" Label="Subtitle Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
            <MudSwitch @bind-Value="_formModel.VmafEnabled" Label="Enable VMAF Quality Scoring by Default" Color="Color.Primary" Class="mb-3" />
            @if (_formModel.VmafEnabled)
            {
                <MudNumericField @bind-Value="_formModel.RequiredVmaf" Label="Required VMAF Score (0-100)" HelperText="If set, system will optimize CRF to meet this score" Variant="Variant.Outlined" Class="mb-3" Min="0" Max="100" />
            }
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isSubmitting || !HasChanges)">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <text>Updating...</text>
                }
                else
                {
                    <text>Update</text>
                }
            </MudButton>
            <MudButton Variant="Variant.Text" Disabled="@_isSubmitting" OnClick="HandleCancel">Cancel</MudButton>
        </EditForm>
        </div>
    </DialogContent>
</MudDialog>

@using VideoConverter.Common.Models

@code {
    [CascadingParameter]
    public IDialogReference MudDialog { get; set; } = default!;

    [Parameter]
    public ProfileDto Profile { get; set; } = default!;

    [Parameter]
    public EventCallback<ProfilePatchRequest> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Inject]
    private ILogger<EditProfileDialog> Logger { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private IRequestValidator<ProfilePatchDto> ProfilePatchValidator { get; set; } = null!;

    private EditForm _editForm = default!;
    private readonly ProfileFormModel _formModel = new();
    private bool _isSubmitting;
    private IDictionary<string, string[]>? _validationErrors;

    protected override void OnInitialized()
    {
        Logger.LogDebug("EditProfileDialog initializing for profile {ProfileId}", Profile.Id);
        _formModel.Name = Profile.Name;
        _formModel.OutputDirectory = Profile.OutputDirectory;
        _formModel.Crf = Profile.Crf;
        _formModel.AudioBitrateKbps = Profile.AudioBitrateKbps;
        if (Profile.AudioChannels.HasValue)
        {
            var enumString = Profile.AudioChannels.Value.ToString();
            if (Enum.TryParse<AudioChannels>(enumString, out var audioChannels))
            {
                _formModel.AudioChannels = audioChannels;
            }
            else
            {
                Logger.LogWarning("Could not parse AudioChannels value: {Value}", enumString);
                _formModel.AudioChannels = null;
            }
        }
        else
        {
            _formModel.AudioChannels = null;
        }

        _formModel.Resolution = Profile.Resolution;
        _formModel.OutputFilenameTemplate = Profile.OutputFilenameTemplate;
        _formModel.OutputPathTemplate = Profile.OutputPathTemplate;
        _formModel.AudioLanguagesString = Profile.AudioLanguages is not null ? string.Join(", ", Profile.AudioLanguages) : null;
        _formModel.SubtitleLanguagesString = Profile.SubtitleLanguages is not null ? string.Join(", ", Profile.SubtitleLanguages) : null;
        _formModel.VmafEnabled = Profile.VmafEnabled;
        _formModel.RequiredVmaf = Profile.RequiredVmaf;
    }

    private async Task HandleValidSubmit()
    {
        Logger.LogInformation("Form submission started for profile {ProfileId}. Name: {Name}", Profile.Id, _formModel.Name);
        _isSubmitting = true;
        try
        {
            var (audioLanguages, subtitleLanguages) = ParseLanguageInputs();

            Logger.LogDebug("Form data converted. AudioLanguages: {AudioLanguages}, SubtitleLanguages: {SubtitleLanguages}",
                audioLanguages != null ? string.Join(", ", audioLanguages) : "null",
                subtitleLanguages != null ? string.Join(", ", subtitleLanguages) : "null");

            var (patch, changedFields) = BuildPatch(Profile, audioLanguages, subtitleLanguages);
            if (changedFields.Count == 0)
            {
                _validationErrors = new Dictionary<string, string[]>
                {
                    { "General", new[] { "No changes to save." } },
                };
                return;
            }

            var validation = await ProfilePatchValidator.ValidateAsync(patch, CancellationToken.None).ConfigureAwait(false);
            if (!validation.IsValid)
            {
                _validationErrors = validation.ToDictionary();
                return;
            }

            _validationErrors = null;
            await OnSubmit.InvokeAsync(new ProfilePatchRequest(patch, changedFields));
            Logger.LogInformation("Form submission completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during form submission");
            throw new InvalidOperationException("Failed to submit profile form", ex);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OpenDirectoryBrowser()
    {
        Logger.LogDebug("Opening directory browser dialog");
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        };

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<FileBrowser>
        {
            { x => x.Title, "Select Output Directory" },
            { x => x.Mode, FileBrowserMode.Directory },
            { x => x.InitialPath, _formModel.OutputDirectory },
            { x => x.OnPathSelected, EventCallback.Factory.Create<string>(this, (path) =>
            {
                HandleDirectorySelected(path);
                dialogRef?.Close();
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        };

        dialogRef = await DialogService.ShowAsync<FileBrowser>("Select Output Directory", parameters, options).ConfigureAwait(false);
    }

    private void HandleDirectorySelected(string path)
    {
        Logger.LogInformation("Directory selected from browser: {Path}", path);
        _formModel.OutputDirectory = path;
        StateHasChanged();
    }

    private bool HasChanges
    {
        get
        {
            var (audioLanguages, subtitleLanguages) = ParseLanguageInputs();
            var (_, changedFields) = BuildPatch(Profile, audioLanguages, subtitleLanguages);
            return changedFields.Count > 0;
        }
    }

    private (IReadOnlyList<string>? Audio, IReadOnlyList<string>? Subtitle) ParseLanguageInputs()
    {
        IReadOnlyList<string>? audioLanguages = null;
        IReadOnlyList<string>? subtitleLanguages = null;

        if (!string.IsNullOrWhiteSpace(_formModel.AudioLanguagesString))
        {
            audioLanguages = _formModel.AudioLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        }

        if (!string.IsNullOrWhiteSpace(_formModel.SubtitleLanguagesString))
        {
            subtitleLanguages = _formModel.SubtitleLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        }

        return (audioLanguages, subtitleLanguages);
    }

    private (ProfilePatchDto Patch, HashSet<string> ChangedFields) BuildPatch(ProfileDto original, IReadOnlyList<string>? audioLanguages, IReadOnlyList<string>? subtitleLanguages)
    {
        var patch = new ProfilePatchDto();
        var changedFields = new HashSet<string>(StringComparer.Ordinal);

        if (!string.Equals(_formModel.Name, original.Name, StringComparison.Ordinal))
        {
            patch.Name = _formModel.Name;
            _ = changedFields.Add(nameof(ProfilePatchDto.Name));
        }

        var normalizedOutputDirectory = string.IsNullOrWhiteSpace(_formModel.OutputDirectory) ? null : _formModel.OutputDirectory;
        if (!string.Equals(normalizedOutputDirectory, original.OutputDirectory, StringComparison.Ordinal))
        {
            patch.OutputDirectory = normalizedOutputDirectory;
            _ = changedFields.Add(nameof(ProfilePatchDto.OutputDirectory));
        }

        if (_formModel.Crf != original.Crf)
        {
            patch.Crf = _formModel.Crf;
            _ = changedFields.Add(nameof(ProfilePatchDto.Crf));
        }

        if (_formModel.AudioBitrateKbps != original.AudioBitrateKbps)
        {
            patch.AudioBitrateKbps = _formModel.AudioBitrateKbps;
            _ = changedFields.Add(nameof(ProfilePatchDto.AudioBitrateKbps));
        }

        if (_formModel.AudioChannels != original.AudioChannels)
        {
            patch.AudioChannels = _formModel.AudioChannels;
            _ = changedFields.Add(nameof(ProfilePatchDto.AudioChannels));
        }

        if (_formModel.Resolution != original.Resolution)
        {
            patch.Resolution = _formModel.Resolution;
            _ = changedFields.Add(nameof(ProfilePatchDto.Resolution));
        }

        if (!string.Equals(_formModel.OutputFilenameTemplate, original.OutputFilenameTemplate, StringComparison.Ordinal))
        {
            patch.OutputFilenameTemplate = _formModel.OutputFilenameTemplate;
            _ = changedFields.Add(nameof(ProfilePatchDto.OutputFilenameTemplate));
        }

        if (!string.Equals(_formModel.OutputPathTemplate, original.OutputPathTemplate, StringComparison.Ordinal))
        {
            patch.OutputPathTemplate = _formModel.OutputPathTemplate;
            _ = changedFields.Add(nameof(ProfilePatchDto.OutputPathTemplate));
        }

        if (!AreListsEqual(audioLanguages, original.AudioLanguages))
        {
            patch.AudioLanguages = audioLanguages;
            _ = changedFields.Add(nameof(ProfilePatchDto.AudioLanguages));
        }

        if (!AreListsEqual(subtitleLanguages, original.SubtitleLanguages))
        {
            patch.SubtitleLanguages = subtitleLanguages;
            _ = changedFields.Add(nameof(ProfilePatchDto.SubtitleLanguages));
        }

        if (_formModel.VmafEnabled != original.VmafEnabled)
        {
            patch.VmafEnabled = _formModel.VmafEnabled;
            _ = changedFields.Add(nameof(ProfilePatchDto.VmafEnabled));
        }

        var effectiveRequiredVmaf = _formModel.VmafEnabled ? _formModel.RequiredVmaf : null;
        if (!AreNullableDoublesEqual(effectiveRequiredVmaf, original.RequiredVmaf))
        {
            patch.RequiredVmaf = effectiveRequiredVmaf;
            _ = changedFields.Add(nameof(ProfilePatchDto.RequiredVmaf));
        }

        return (patch, changedFields);
    }

    private static bool AreListsEqual(IEnumerable<string>? left, IEnumerable<string>? right)
    {
        if (left is null && right is null)
        {
            return true;
        }

        if (left is null || right is null)
        {
            return false;
        }

        return left.SequenceEqual(right);
    }

    private static bool AreNullableDoublesEqual(double? left, double? right)
    {
        if (!left.HasValue && !right.HasValue)
        {
            return true;
        }

        if (!left.HasValue || !right.HasValue)
        {
            return false;
        }

        return Math.Abs(left.Value - right.Value) <= 0.001;
    }

    private async Task HandleCancel()
    {
        Logger.LogDebug("Edit profile dialog cancelled");
        await OnCancel.InvokeAsync().ConfigureAwait(false);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (EditConversionDialogLogic.ShouldAllowSubmission(e.Key, _isSubmitting, _editForm.EditContext?.Validate() == true))
        {
            Logger.LogDebug("Enter key pressed and form is valid, triggering form submission");
            await HandleValidSubmit();
        }
    }

    private sealed class ProfileFormModel
    {
        public string Name { get; set; } = string.Empty;

        public string? OutputDirectory { get; set; }

        public int? Crf { get; set; }

        public int? AudioBitrateKbps { get; set; }

        public AudioChannels? AudioChannels { get; set; }

        public int? Resolution { get; set; }

        public string? OutputFilenameTemplate { get; set; }

        public string? OutputPathTemplate { get; set; }

        public string? AudioLanguagesString { get; set; }

        public string? SubtitleLanguagesString { get; set; }

        public bool VmafEnabled { get; set; }

        public double? RequiredVmaf { get; set; }
    }
}
