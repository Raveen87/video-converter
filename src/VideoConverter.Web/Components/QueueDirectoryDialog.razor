@using VideoConverter.Common.Constants

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Queue Directory for Conversion</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_formModel" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            @if (_validationErrors is not null && _validationErrors.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-3">
                    <ul class="mb-0">
                        @foreach (var kvp in _validationErrors)
                        {
                            foreach (var message in kvp.Value)
                            {
                                <li><strong>@kvp.Key:</strong> @message</li>
                            }
                        }
                    </ul>
                </MudAlert>
            }
            <MudSelect T="int?" Value="@_selectedProfileId" ValueChanged="@HandleProfileSelectionChanged" Label="Profile (optional)" Variant="Variant.Outlined" Class="mb-3" Clearable="true">
                <MudSelectItem T="int?" Value="@((int?)null)">None (use manual settings)</MudSelectItem>
                @foreach (var profile in _profiles)
                {
                    <MudSelectItem T="int?" Value="@profile.Id">@profile.Name</MudSelectItem>
                }
            </MudSelect>
            @if (_selectedProfileId is not null)
            {
                <MudAlert Severity="Severity.Info" Class="mb-3">
                    Using profile: <strong>@GetSelectedProfileName()</strong>. You can override any settings below.
                </MudAlert>
            }
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.DirectoryPath" Label="Directory Path" Required="true" Variant="Variant.Outlined" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenDirectoryBrowser" Class="ml-2" Style="height: 56px;">
                    Browse
                </MudButton>
            </div>
            <div class="d-flex align-center mb-3">
                <MudTextField @bind-Value="_formModel.OutputDirectory" Label="Output Directory" Required="true" Variant="Variant.Outlined" Class="flex-grow-1" />
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="OpenOutputDirectoryBrowser" Class="ml-2" Style="height: 56px;">
                    Browse
                </MudButton>
            </div>
            <MudTextField @bind-Value="_formModel.ExtensionsString" Label="File Extensions (comma-separated)" HelperText="e.g., .mkv,.mp4 (defaults to .mkv,.mp4 if empty)" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_formModel.Crf" Label="CRF (Quality)" HelperText="Lower is higher quality (18-28 recommended)" Variant="Variant.Outlined" Class="mb-3" />
            <MudNumericField @bind-Value="_formModel.AudioBitrateKbps" Label="Audio Bitrate (Kbps)" Variant="Variant.Outlined" Class="mb-3" />
            <MudSelect T="AudioChannels?" @bind-Value="_formModel.AudioChannels" Label="Audio Channels" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="AudioChannels?" Value="@((AudioChannels?)null)">Default</MudSelectItem>
                <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Stereo20">Stereo 2.0</MudSelectItem>
                <MudSelectItem T="AudioChannels?" Value="@AudioChannels.Surround51">Surround 5.1</MudSelectItem>
            </MudSelect>
            <MudSelect T="int?" @bind-Value="_formModel.Resolution" Label="Resolution" Variant="Variant.Outlined" Class="mb-3">
                <MudSelectItem T="int?" Value="@((int?)null)">Keep source</MudSelectItem>
                @foreach (var resolution in ResolutionOptions.Allowed)
                {
                    <MudSelectItem T="int?" Value="@resolution">@($"{resolution}p")</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_formModel.OutputFilenameTemplate" Label="Output Filename Template" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_formModel.OutputPathTemplate" Label="Output Path Template" HelperText="e.g., {Type}/{Title}/Season {Season:00}" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_formModel.AudioLanguagesString" Label="Audio Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField @bind-Value="_formModel.SubtitleLanguagesString" Label="Subtitle Languages (comma-separated)" Variant="Variant.Outlined" Class="mb-3" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <text>Queueing...</text>
                }
                else
                {
                    <text>Queue Directory</text>
                }
            </MudButton>
            <MudButton Variant="Variant.Text" Disabled="@_isSubmitting" OnClick="HandleCancel">Cancel</MudButton>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter]
    public IDialogReference MudDialog { get; set; } = default!;
    [Parameter]
    public DirectoryQueueRequestDto? InitialModel { get; set; }

    [Parameter]
    public EventCallback<DirectoryQueueRequestDto> OnSubmit { get; set; }

    [Parameter]
    public EventCallback<(int ProfileId, ProfileDirectoryQueueRequestDto Request)> OnSubmitWithProfile { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    [Inject]
    private ILogger<QueueDirectoryDialog> Logger { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private IVideoConverterApiClient ApiClient { get; set; } = null!;

    [Inject]
    private IRequestValidator<DirectoryQueueRequestDto> DirectoryQueueValidator { get; set; } = null!;

    [Inject]
    private IRequestValidator<ProfileDirectoryQueueRequestDto> ProfileDirectoryQueueValidator { get; set; } = null!;

    private readonly DirectoryFormModel _formModel = new();
    private bool _isSubmitting;
    private List<ProfileDto> _profiles = [];
    private int? _selectedProfileId;
    private IDictionary<string, string[]>? _validationErrors;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogDebug("QueueDirectoryDialog initializing");
        await LoadProfilesAsync().ConfigureAwait(false);
        if (InitialModel is not null)
        {
            Logger.LogDebug("Initializing dialog with existing model. Directory: {DirectoryPath}", InitialModel.DirectoryPath);
            _formModel.DirectoryPath = InitialModel.DirectoryPath;
            _formModel.OutputDirectory = InitialModel.OutputDirectory;
            _formModel.Crf = InitialModel.Crf;
            _formModel.AudioBitrateKbps = InitialModel.AudioBitrateKbps;
            _formModel.AudioChannels = InitialModel.AudioChannels;
            _formModel.Resolution = InitialModel.Resolution ?? _formModel.Resolution;
            _formModel.OutputFilenameTemplate = InitialModel.OutputFilenameTemplate;
            _formModel.OutputPathTemplate = InitialModel.OutputPathTemplate;
            _formModel.AudioLanguagesString = InitialModel.AudioLanguages is not null ? string.Join(", ", InitialModel.AudioLanguages) : null;
            _formModel.SubtitleLanguagesString = InitialModel.SubtitleLanguages is not null ? string.Join(", ", InitialModel.SubtitleLanguages) : null;
            _formModel.ExtensionsString = InitialModel.Extensions is not null ? string.Join(", ", InitialModel.Extensions) : null;
        }
        else
        {
            Logger.LogDebug("Initializing dialog with empty form");
        }
    }

    private async Task LoadProfilesAsync()
    {
        try
        {
            var profiles = await ApiClient.GetProfilesAsync().ConfigureAwait(false);
            _profiles = profiles.ToList();
            Logger.LogDebug("Loaded {ProfileCount} profiles", _profiles.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading profiles");
            _profiles = [];
        }
    }

    private async Task<bool> ValidateAndSetErrorsAsync<TRequest>(IRequestValidator<TRequest> validator, TRequest request)
    {
        var validation = await validator.ValidateAsync(request, CancellationToken.None).ConfigureAwait(false);
        if (!validation.IsValid)
        {
            _validationErrors = validation.ToDictionary();
            return false;
        }

        _validationErrors = null;
        return true;
    }

    private async Task HandleValidSubmit()
    {
        Logger.LogInformation("Form submission started. Directory: {DirectoryPath}, Output: {OutputDirectory}, Profile: {ProfileName}",
            _formModel.DirectoryPath, _formModel.OutputDirectory, _selectedProfileId.HasValue ? GetSelectedProfileName() : "None");
        _isSubmitting = true;
        try
        {
            var extensions = !string.IsNullOrWhiteSpace(_formModel.ExtensionsString)
                ? _formModel.ExtensionsString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                : null;

            if (_selectedProfileId is not null)
            {
                // Convert string fields back to proper types for overrides
                var audioLanguages = !string.IsNullOrWhiteSpace(_formModel.AudioLanguagesString)
                    ? _formModel.AudioLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    : null;
                var subtitleLanguages = !string.IsNullOrWhiteSpace(_formModel.SubtitleLanguagesString)
                    ? _formModel.SubtitleLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    : null;

                Logger.LogDebug("Submitting with profile {ProfileId}. AudioLanguages: {AudioLanguages}, SubtitleLanguages: {SubtitleLanguages}, Extensions: {Extensions}",
                    _selectedProfileId.Value,
                    audioLanguages != null ? string.Join(", ", audioLanguages) : "null",
                    subtitleLanguages != null ? string.Join(", ", subtitleLanguages) : "null",
                    extensions != null ? string.Join(", ", extensions) : "null");

                var profileRequest = new ProfileDirectoryQueueRequestDto(
                    _formModel.DirectoryPath,
                    _formModel.OutputDirectory,
                    extensions,
                    _formModel.Crf,
                    _formModel.AudioBitrateKbps,
                    _formModel.AudioChannels,
                    _formModel.Resolution,
                    audioLanguages,
                    subtitleLanguages,
                    _formModel.OutputFilenameTemplate,
                    _formModel.OutputPathTemplate);

                if (!await ValidateAndSetErrorsAsync(ProfileDirectoryQueueValidator, profileRequest).ConfigureAwait(false))
                {
                    return;
                }

                await OnSubmitWithProfile.InvokeAsync((_selectedProfileId.Value, profileRequest)).ConfigureAwait(false);
            }
            else
            {
                // Convert string fields back to proper types
                var audioLanguages = !string.IsNullOrWhiteSpace(_formModel.AudioLanguagesString)
                    ? _formModel.AudioLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    : null;
                var subtitleLanguages = !string.IsNullOrWhiteSpace(_formModel.SubtitleLanguagesString)
                    ? _formModel.SubtitleLanguagesString.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    : null;

                Logger.LogDebug("Form data converted. AudioLanguages: {AudioLanguages}, SubtitleLanguages: {SubtitleLanguages}, Extensions: {Extensions}",
                    audioLanguages != null ? string.Join(", ", audioLanguages) : "null",
                    subtitleLanguages != null ? string.Join(", ", subtitleLanguages) : "null",
                    extensions != null ? string.Join(", ", extensions) : "null");

                var request = new DirectoryQueueRequestDto(
                    _formModel.DirectoryPath,
                    _formModel.OutputDirectory,
                    _formModel.Crf,
                    _formModel.AudioBitrateKbps,
                    _formModel.AudioChannels,
                    _formModel.Resolution,
                    audioLanguages,
                    subtitleLanguages,
                    _formModel.OutputFilenameTemplate,
                    _formModel.OutputPathTemplate,
                    extensions);

                if (!await ValidateAndSetErrorsAsync(DirectoryQueueValidator, request).ConfigureAwait(false))
                {
                    return;
                }

                await OnSubmit.InvokeAsync(request).ConfigureAwait(false);
            }

            Logger.LogInformation("Form submission completed successfully");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during form submission");
            throw new InvalidOperationException("Failed to submit directory queue form", ex);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task OpenDirectoryBrowser()
    {
        Logger.LogDebug("Opening directory browser dialog");
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        };

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<FileBrowser>
        {
            { x => x.Title, "Select Directory to Queue" },
            { x => x.Mode, FileBrowserMode.Directory },
            { x => x.InitialPath, _formModel.DirectoryPath },
            { x => x.OnPathSelected, EventCallback.Factory.Create<string>(this, (path) =>
            {
                HandleDirectorySelected(path);
                dialogRef?.Close();
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        };

        dialogRef = await DialogService.ShowAsync<FileBrowser>("Select Directory to Queue", parameters, options).ConfigureAwait(false);
    }

    private async Task OpenOutputDirectoryBrowser()
    {
        Logger.LogDebug("Opening output directory browser dialog");
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        };

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<FileBrowser>
        {
            { x => x.Title, "Select Output Directory" },
            { x => x.Mode, FileBrowserMode.Directory },
            { x => x.InitialPath, _formModel.OutputDirectory },
            { x => x.OnPathSelected, EventCallback.Factory.Create<string>(this, (path) =>
            {
                HandleOutputDirectorySelected(path);
                dialogRef?.Close();
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        };

        dialogRef = await DialogService.ShowAsync<FileBrowser>("Select Output Directory", parameters, options).ConfigureAwait(false);
    }

    private void HandleDirectorySelected(string path)
    {
        Logger.LogInformation("Directory selected from browser: {Path}", path);
        _formModel.DirectoryPath = path;
        StateHasChanged();
    }

    private void HandleOutputDirectorySelected(string path)
    {
        Logger.LogInformation("Output directory selected from browser: {Path}", path);
        _formModel.OutputDirectory = path;
        StateHasChanged();
    }

    private async Task HandleCancel()
    {
        Logger.LogDebug("Queue directory dialog cancelled");
        await OnCancel.InvokeAsync().ConfigureAwait(false);
    }

    private string GetSelectedProfileName()
    {
        var profile = _profiles.FirstOrDefault(p => p.Id == _selectedProfileId);
        return profile?.Name ?? "Unknown Profile";
    }

    private void HandleProfileSelectionChanged(int? profileId)
    {
        _selectedProfileId = profileId;
        if (profileId.HasValue)
        {
            var profile = _profiles.FirstOrDefault(p => p.Id == profileId);
            if (profile is not null)
            {
                if (string.IsNullOrWhiteSpace(_formModel.OutputDirectory) && !string.IsNullOrWhiteSpace(profile.OutputDirectory))
                {
                    _formModel.OutputDirectory = profile.OutputDirectory!;
                }

                if (!_formModel.Crf.HasValue && profile.Crf.HasValue)
                {
                    _formModel.Crf = profile.Crf;
                }

                if (!_formModel.AudioBitrateKbps.HasValue && profile.AudioBitrateKbps.HasValue)
                {
                    _formModel.AudioBitrateKbps = profile.AudioBitrateKbps;
                }

                if (!_formModel.AudioChannels.HasValue && profile.AudioChannels.HasValue)
                {
                    _formModel.AudioChannels = profile.AudioChannels;
                }

                _formModel.Resolution = profile.Resolution ?? _formModel.Resolution;

                if (string.IsNullOrWhiteSpace(_formModel.OutputFilenameTemplate) && !string.IsNullOrWhiteSpace(profile.OutputFilenameTemplate))
                {
                    _formModel.OutputFilenameTemplate = profile.OutputFilenameTemplate;
                }

                if (string.IsNullOrWhiteSpace(_formModel.OutputPathTemplate) && !string.IsNullOrWhiteSpace(profile.OutputPathTemplate))
                {
                    _formModel.OutputPathTemplate = profile.OutputPathTemplate;
                }

                if (string.IsNullOrWhiteSpace(_formModel.AudioLanguagesString) && profile.AudioLanguages is not null)
                {
                    _formModel.AudioLanguagesString = string.Join(", ", profile.AudioLanguages);
                }

                if (string.IsNullOrWhiteSpace(_formModel.SubtitleLanguagesString) && profile.SubtitleLanguages is not null)
                {
                    _formModel.SubtitleLanguagesString = string.Join(", ", profile.SubtitleLanguages);
                }
            }
        }

        StateHasChanged();
    }

    private sealed class DirectoryFormModel
    {
        public string DirectoryPath { get; set; } = string.Empty;

        public string OutputDirectory { get; set; } = string.Empty;

        public string? ExtensionsString { get; set; }

        public int? Crf { get; set; }

        public int? AudioBitrateKbps { get; set; }

        public AudioChannels? AudioChannels { get; set; }

        public int? Resolution { get; set; } = ResolutionOptions.Default;

        public string? OutputFilenameTemplate { get; set; }

        public string? OutputPathTemplate { get; set; }

        public string? AudioLanguagesString { get; set; }

        public string? SubtitleLanguagesString { get; set; }
    }
}
