@page "/conversions"

<PageTitle>Conversions</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Conversion Overview</MudText>
        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateConversionDialog" Class="mr-2">
                Create Conversion
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Folder" OnClick="OpenQueueDirectoryDialog">
                Queue Directory
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        <MudText>Loading conversions...</MudText>
    }
    else if (_conversions.Count == 0)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.body1">No conversions found.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_conversions" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Input Path</MudTh>
                <MudTh>Output Directory</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Progress</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Input Path">
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;">
                        @context.InputPath
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Output Directory">
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;">
                        @context.OutputDirectory
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Created">
                    <MudText Typo="Typo.body2">@context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                </MudTd>
                <MudTd DataLabel="Progress">
                    @if (_progressData.TryGetValue(context.Id, out var progress) && progress != null)
                    {
                        <MudProgressLinear Color="@GetProgressColor(progress.Status)" Value="@(progress.PercentageComplete ?? 0)" Class="@($"mb-2 {GetProgressClass(progress.Status)}")" />
                        <MudText Typo="Typo.caption">
                            @if (progress.PercentageComplete.HasValue)
                            {
                                <text>@($"{progress.PercentageComplete:F1}%")</text>
                            }
                            else
                            {
                                <text>@progress.Status</text>
                            }
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Default">Unknown</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButtonGroup Variant="Variant.Text" Size="Size.Small">
                        <MudButton StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => StartConversion(context.Id))" Size="Size.Small">
                            Start
                        </MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Pause" OnClick="@(() => PauseConversion(context.Id))" Size="Size.Small">
                            Pause
                        </MudButton>
                        <MudButton StartIcon="@Icons.Material.Filled.Stop" OnClick="@(() => StopConversion(context.Id))" Size="Size.Small" Color="Color.Error">
                            Stop
                        </MudButton>
                    </MudButtonGroup>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@implements IDisposable

@code {
    private readonly List<ConversionDto> _conversions = new();
    private readonly Dictionary<int, ConversionProgressDto?> _progressData = new();
    private bool _isLoading = true;
    private CancellationTokenSource? _pollingCts;
    private const int PollingIntervalMs = 2000; // Poll every 2 seconds

    [Inject]
    private IVideoConverterApiClient ApiClient { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private ILogger<Conversions> Logger { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Conversions page initializing");
        await LoadConversionsAsync().ConfigureAwait(false);
        StartPolling();
        Logger.LogInformation("Conversions page initialized. Loaded {Count} conversions", _conversions.Count);
    }

    private async Task LoadConversionsAsync()
    {
        Logger.LogDebug("Loading conversions from API");
        try
        {
            _isLoading = true;
            var conversions = await ApiClient.GetConversionsAsync().ConfigureAwait(false);
            _conversions.Clear();
            _conversions.AddRange(conversions);
            Logger.LogInformation("Successfully loaded {Count} conversions", conversions.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading conversions from API");
            Snackbar.Add($"Error loading conversions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartPolling()
    {
        Logger.LogInformation("Starting progress polling with interval {IntervalMs}ms", PollingIntervalMs);
        _pollingCts = new CancellationTokenSource();
        _ = Task.Run(async () =>
        {
            try
            {
                while (!_pollingCts.Token.IsCancellationRequested)
                {
                    await PollProgressAsync(_pollingCts.Token).ConfigureAwait(false);
                    await Task.Delay(PollingIntervalMs, _pollingCts.Token).ConfigureAwait(false);
                }
                Logger.LogInformation("Progress polling stopped (cancellation requested)");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unhandled exception in polling loop");
                await InvokeAsync(() =>
                {
                    Snackbar.Add($"Polling stopped due to an unexpected error: {ex.Message}", Severity.Error);
                });
            }
        }, _pollingCts.Token);
    }

    private async Task PollProgressAsync(CancellationToken cancellationToken)
    {
        if (_conversions.Count == 0 || cancellationToken.IsCancellationRequested)
        {
            return;
        }

        try
        {
            Logger.LogDebug("Polling progress for {Count} conversions", _conversions.Count);
            // Poll progress for all conversions
            var tasks = _conversions.Select(c => ApiClient.GetConversionProgressAsync(c.Id, cancellationToken));
            var results = await Task.WhenAll(tasks).ConfigureAwait(false);

            await InvokeAsync(() =>
            {
                for (var i = 0; i < _conversions.Count; i++)
                {
                    var conversion = _conversions[i];
                    var progress = results[i];
                    var previousProgress = _progressData.TryGetValue(conversion.Id, out var prev) ? prev : null;
                    _progressData[conversion.Id] = progress;

                    // Log when progress changes
                    var hasChanged = previousProgress == null;
                    if (!hasChanged && previousProgress != null && progress != null)
                    {
                        hasChanged = previousProgress.Status != progress.Status;
                        if (!hasChanged && previousProgress.PercentageComplete.HasValue && progress.PercentageComplete.HasValue)
                        {
                            var prevValue = previousProgress.PercentageComplete.Value;
                            var currValue = progress.PercentageComplete.Value;
                            hasChanged = Math.Abs(prevValue - currValue) > 0.01;
                        }
                        else if (!hasChanged)
                        {
                            hasChanged = previousProgress.PercentageComplete.HasValue != progress.PercentageComplete.HasValue;
                        }
                    }

                    if (progress != null && hasChanged)
                    {
                        Logger.LogDebug(
                            "Progress updated for conversion {ConversionId}: {Status}, {Percentage}%",
                            conversion.Id,
                            progress.Status,
                            progress.PercentageComplete?.ToString("F1") ?? "N/A");
                    }
                }
                StateHasChanged();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogDebug(ex, "Progress polling cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error polling progress for conversions");
        }
    }

    private async Task StartConversion(int id)
    {
        Logger.LogInformation("User action: Starting conversion {ConversionId}", id);
        try
        {
            await ApiClient.StartConversionAsync(id).ConfigureAwait(false);
            await LoadConversionsAsync().ConfigureAwait(false);
            Logger.LogInformation("Successfully started conversion {ConversionId}", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting conversion {ConversionId}", id);
            Snackbar.Add($"Error starting conversion: {ex.Message}", Severity.Error);
        }
    }

    private async Task PauseConversion(int id)
    {
        Logger.LogInformation("User action: Pausing conversion {ConversionId}", id);
        try
        {
            await ApiClient.PauseConversionAsync(id).ConfigureAwait(false);
            Logger.LogInformation("Successfully paused conversion {ConversionId}", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error pausing conversion {ConversionId}", id);
            Snackbar.Add($"Error pausing conversion: {ex.Message}", Severity.Error);
        }
    }

    private async Task StopConversion(int id)
    {
        Logger.LogInformation("User action: Stopping conversion {ConversionId}", id);
        try
        {
            await ApiClient.StopConversionAsync(id).ConfigureAwait(false);
            Logger.LogInformation("Successfully stopped conversion {ConversionId}", id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error stopping conversion {ConversionId}", id);
            Snackbar.Add($"Error stopping conversion: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCreateConversionDialog()
    {
        Logger.LogInformation("User action: Opening create conversion dialog");
        IDialogReference? dialogRef = null;
        dialogRef = await DialogService.ShowAsync<CreateConversionDialog>("Create Conversion", new DialogParameters<CreateConversionDialog>
        {
            { x => x.InitialModel, null },
            { x => x.OnSubmit, EventCallback.Factory.Create<ConversionCreateDto>(this, async (request) =>
            {
                await CreateConversionOptimisticAsync(request).ConfigureAwait(false);
                dialogRef?.Close();
                Logger.LogDebug("Create conversion dialog closed");
            }) },
        }, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        }).ConfigureAwait(false);
        Logger.LogDebug("Create conversion dialog opened");
    }

    private async Task OpenQueueDirectoryDialog()
    {
        Logger.LogInformation("User action: Opening queue directory dialog");
        IDialogReference? dialogRef = null;
        dialogRef = await DialogService.ShowAsync<QueueDirectoryDialog>("Queue Directory", new DialogParameters<QueueDirectoryDialog>
        {
            { x => x.InitialModel, null },
            { x => x.OnSubmit, EventCallback.Factory.Create<DirectoryQueueRequestDto>(this, async (request) =>
            {
                await QueueDirectoryAsync(request).ConfigureAwait(false);
                dialogRef?.Close();
                Logger.LogDebug("Queue directory dialog closed");
            }) },
        }, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        }).ConfigureAwait(false);
        Logger.LogDebug("Queue directory dialog opened");
    }

    private async Task CreateConversionOptimisticAsync(ConversionCreateDto request)
    {
        Logger.LogInformation("Creating conversion with optimistic update. Input: {InputPath}", request.InputPath);
        // Create a temporary conversion for optimistic update
        var tempId = GetNextTempId();
        var tempConversion = new ConversionDto(
            tempId,
            request.InputPath,
            request.OutputDirectory,
            DateTime.UtcNow,
            request.Crf,
            request.AudioBitrateKbps,
            request.AudioChannels,
            request.Resolution,
            request.OutputFilenameTemplate);

        Logger.LogDebug("Added temporary conversion with ID {TempId} for optimistic update", tempId);
        // Add optimistically to the list
        await InvokeAsync(() =>
        {
            _conversions.Insert(0, tempConversion);
            StateHasChanged();
        }).ConfigureAwait(false);

        try
        {
            // Make the actual API call
            var created = await ApiClient.CreateConversionAsync(request).ConfigureAwait(false);

            Logger.LogInformation("Conversion created successfully with ID {ConversionId}, replacing temporary ID {TempId}", 
                created.Id, tempId);
            // Replace the temporary conversion with the real one
            await InvokeAsync(() =>
            {
                var index = _conversions.FindIndex(c => c.Id == tempId);
                if (index >= 0)
                {
                    _conversions[index] = created;
                }
                else
                {
                    Logger.LogWarning("Temporary conversion {TempId} not found in list, adding created conversion at index 0", tempId);
                    // If not found, just add it (shouldn't happen, but be safe)
                    _conversions.Insert(0, created);
                }

                StateHasChanged();
            }).ConfigureAwait(false);

            Snackbar.Add("Conversion created successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating conversion, removing temporary conversion {TempId}", tempId);
            // Remove the temporary conversion on error
            await InvokeAsync(() =>
            {
                _conversions.RemoveAll(c => c.Id == tempId);
                StateHasChanged();
            }).ConfigureAwait(false);

            Snackbar.Add($"Error creating conversion: {ex.Message}", Severity.Error);
        }
    }

    private async Task QueueDirectoryAsync(DirectoryQueueRequestDto request)
    {
        Logger.LogInformation("Queueing directory for conversion. Directory: {DirectoryPath}", request.DirectoryPath);
        try
        {
            var batchId = await ApiClient.QueueDirectoryAsync(request).ConfigureAwait(false);
            Logger.LogInformation("Successfully queued directory with batch ID {BatchId}", batchId);
            Snackbar.Add($"Directory queued successfully. Batch ID: {batchId}", Severity.Success);

            // Refresh conversions list in case any were created immediately
            await LoadConversionsAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error queueing directory. Directory: {DirectoryPath}", request.DirectoryPath);
            Snackbar.Add($"Error queueing directory: {ex.Message}", Severity.Error);
        }
    }

    private int GetNextTempId()
    {
        // Use negative IDs for temporary conversions to avoid conflicts
        var existingTempIds = _conversions.Where(c => c.Id < 0).Select(c => c.Id).ToList();
        if (existingTempIds.Count == 0)
        {
            return -1;
        }

        return existingTempIds.Min() - 1;
    }

    private static Color GetProgressColor(ConversionStatus status)
    {
        return status switch
        {
            ConversionStatus.Running => Color.Success,
            ConversionStatus.Waiting => Color.Info,
            _ => Color.Default,
        };
    }

    private static string GetProgressClass(ConversionStatus status)
    {
        return status switch
        {
            ConversionStatus.Running => "conversion-running",
            ConversionStatus.Waiting => "conversion-waiting",
            _ => string.Empty,
        };
    }

    public void Dispose()
    {
        Logger.LogInformation("Conversions page disposing, stopping progress polling");
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
    }
}

