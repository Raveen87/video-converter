@page "/conversions"

<PageTitle>Conversions</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Conversion Overview</MudText>
        <div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateConversionDialog" Class="mr-2">
                Create Conversion
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Folder" OnClick="OpenQueueDirectoryDialog" Class="mr-2">
                Queue Directory
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="StartQueue" Disabled="@(!_hasPendingConversions || _isRunning || _isPaused)" Class="mr-2">
                Start Queue
            </MudButton>
            @if (_isPaused)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="ResumeQueue" Disabled="@(!_isPaused)" Class="mr-2">
                    Resume Queue
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Pause" OnClick="PauseQueue" Disabled="@(!_isRunning || _isPaused)" Class="mr-2">
                    Pause Queue
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopQueue" Disabled="@(!_isRunning && !_isPaused)">
                Stop Queue
            </MudButton>
        </div>
    </div>

    @if (!_isLoading)
    {
        <MudPaper Class="pa-4 mb-4">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h6">Pending Queue</MudText>
                <div class="d-flex align-center">
                    @if (_pendingOrderDirty)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Class="mr-2">Unsaved changes</MudText>
                    }
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(!_pendingOrderDirty || _pendingConversions.Count == 0 || _isSavingQueueOrder)"
                               OnClick="SaveQueueOrderAsync">
                        Save Queue Order
                    </MudButton>
                </div>
            </div>
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                Drag and drop queued items to change their processing order. Changes are applied once you save.
            </MudAlert>
            <QueueList Items="@_pendingConversions" OnOrderChanged="HandleQueueOrderChanged" />
        </MudPaper>
    }

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        <MudText>Loading conversions...</MudText>
    }
    else if (_conversions.Count == 0)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.body1">No conversions found.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_conversions" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Input Path</MudTh>
                <MudTh>Output Directory</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Input Path">
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;">
                        @context.InputPath
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Output Directory">
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;">
                        @context.OutputDirectory
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Created">
                    <MudText Typo="Typo.body2">@context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @{
                        var effectiveStatus = GetEffectiveStatus(context);
                        var progress = _progressData.TryGetValue(context.Id, out var prog) ? prog : null;
                        var isRunning = effectiveStatus == ConversionItemStatus.Running && progress?.Status == ConversionProgressStatus.Running && !_isPaused;
                        var isPaused = effectiveStatus == ConversionItemStatus.Running && _isPaused;
                    }
                    @if (isPaused && progress != null)
                    {
                        <div>
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" Class="mb-2">
                                Paused
                            </MudChip>
                            <MudProgressLinear Color="Color.Warning" Value="@(progress.PercentageComplete ?? 0)" Class="mb-1" />
                            <MudText Typo="Typo.caption">
                                @if (progress.PercentageComplete.HasValue)
                                {
                                    <text>@($"{progress.PercentageComplete:F1}%")</text>
                                }
                            </MudText>
                        </div>
                    }
                    else if (isRunning && progress != null)
                    {
                        <div>
                            <MudChip T="ConversionItemStatus" Variant="Variant.Text" Color="@GetStatusColor(effectiveStatus)" Size="Size.Small" Class="mb-2">
                                @effectiveStatus
                            </MudChip>
                            <MudProgressLinear Color="@GetStatusColor(effectiveStatus)" Value="@(progress.PercentageComplete ?? 0)" Class="mb-1" />
                            <MudText Typo="Typo.caption">
                                @if (progress.PercentageComplete.HasValue)
                                {
                                    <text>@($"{progress.PercentageComplete:F1}%")</text>
                                }
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudChip T="ConversionItemStatus" Variant="Variant.Text" Color="@GetStatusColor(effectiveStatus)" Size="Size.Small">
                            @effectiveStatus
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditConversionDialog(context))" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                        Edit
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@implements IDisposable

@code {
    private readonly List<ConversionDto> _conversions = new();
    private readonly List<ConversionDto> _pendingConversions = new();
    private readonly Dictionary<int, ConversionProgressDto?> _progressData = new();
    private bool _isLoading = true;
    private CancellationTokenSource? _pollingCts;
    private const int PollingIntervalMs = 2000; // Poll every 2 seconds
    private bool _isRunning = false;
    private bool _isPaused = false;
    private bool _hasPendingConversions = false;
    private bool _pendingOrderDirty;
    private bool _isSavingQueueOrder;

    [Inject]
    private IVideoConverterApiClient ApiClient { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private ILogger<Conversions> Logger { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Conversions page initializing");
        await LoadConversionsAsync().ConfigureAwait(false);
        StartPolling();
        Logger.LogInformation("Conversions page initialized. Loaded {Count} conversions", _conversions.Count);
    }

    private async Task LoadConversionsAsync()
    {
        Logger.LogDebug("Loading conversions from API");
        try
        {
            _isLoading = true;
            var conversions = await ApiClient.GetConversionsAsync().ConfigureAwait(false);
            _conversions.Clear();
            _conversions.AddRange(conversions);
            ResetPendingQueueFromServer();
            RecalculateQueueFlags();
            Logger.LogInformation("Successfully loaded {Count} conversions", conversions.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading conversions from API");
            Snackbar.Add($"Error loading conversions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetPendingQueueFromServer()
    {
        _pendingConversions.Clear();
        _pendingConversions.AddRange(_conversions.Where(c => c.Status == ConversionItemStatus.Pending));
        _pendingOrderDirty = false;
    }

    private void RecalculateQueueFlags()
    {
        _isRunning = _conversions.Any(c => c.Status == ConversionItemStatus.Running)
            || _progressData.Values.Any(progress => progress?.Status == ConversionProgressStatus.Running);

        // Clear paused state if there's no running conversion
        if (!_isRunning)
        {
            _isPaused = false;
        }

        _hasPendingConversions = _conversions.Any(c => c.Status == ConversionItemStatus.Pending)
            || _progressData.Values.Any(progress => progress?.Status == ConversionProgressStatus.Waiting);
    }

    private void StartPolling()
    {
        Logger.LogInformation("Starting progress polling with interval {IntervalMs}ms", PollingIntervalMs);
        _pollingCts = new CancellationTokenSource();
        _ = Task.Run(async () =>
        {
            try
            {
                while (!_pollingCts.Token.IsCancellationRequested)
                {
                    await PollProgressAsync(_pollingCts.Token).ConfigureAwait(false);
                    await Task.Delay(PollingIntervalMs, _pollingCts.Token).ConfigureAwait(false);
                }
                Logger.LogInformation("Progress polling stopped (cancellation requested)");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Unhandled exception in polling loop");
                await InvokeAsync(() =>
                {
                    Snackbar.Add($"Polling stopped due to an unexpected error: {ex.Message}", Severity.Error);
                });
            }
        }, _pollingCts.Token);
    }

    private async Task PollProgressAsync(CancellationToken cancellationToken)
    {
        if (_conversions.Count == 0 || cancellationToken.IsCancellationRequested)
        {
            return;
        }

        try
        {
            Logger.LogDebug("Polling progress for {Count} conversions", _conversions.Count);
            // Poll progress for all conversions
            var tasks = _conversions.Select(c => ApiClient.GetConversionProgressAsync(c.Id, cancellationToken));
            var results = await Task.WhenAll(tasks).ConfigureAwait(false);

            await InvokeAsync(() =>
            {
                for (var i = 0; i < _conversions.Count; i++)
                {
                    var conversion = _conversions[i];
                    var progress = results[i];
                    var previousProgress = _progressData.TryGetValue(conversion.Id, out var prev) ? prev : null;
                    _progressData[conversion.Id] = progress;

                    // Log when progress changes
                    var hasChanged = previousProgress == null;
                    if (!hasChanged && previousProgress != null && progress != null)
                    {
                        hasChanged = previousProgress.Status != progress.Status;
                        if (!hasChanged && previousProgress.PercentageComplete.HasValue && progress.PercentageComplete.HasValue)
                        {
                            var prevValue = previousProgress.PercentageComplete.Value;
                            var currValue = progress.PercentageComplete.Value;
                            hasChanged = Math.Abs(prevValue - currValue) > 0.01;
                        }
                        else if (!hasChanged)
                        {
                            hasChanged = previousProgress.PercentageComplete.HasValue != progress.PercentageComplete.HasValue;
                        }
                    }

                    if (progress != null && hasChanged)
                    {
                        Logger.LogDebug(
                            "Progress updated for conversion {ConversionId}: {Status}, {Percentage}%",
                            conversion.Id,
                            progress.Status,
                            progress.PercentageComplete?.ToString("F1") ?? "N/A");
                    }
                }
                StateHasChanged();
                RecalculateQueueFlags();
            }).ConfigureAwait(false);
        }
        catch (OperationCanceledException ex)
        {
            Logger.LogDebug(ex, "Progress polling cancelled");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error polling progress for conversions");
        }
    }

    private async Task StartQueue()
    {
        Logger.LogInformation("User action: Starting queue");
        try
        {
            await ApiClient.StartQueueAsync().ConfigureAwait(false);
            _isPaused = false;
            await LoadConversionsAsync().ConfigureAwait(false);
            Snackbar.Add("Queue started successfully", Severity.Success);
            Logger.LogInformation("Successfully started queue");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error starting queue");
            Snackbar.Add($"Error starting queue: {ex.Message}", Severity.Error);
        }
    }

    private async Task PauseQueue()
    {
        Logger.LogInformation("User action: Pausing queue");
        try
        {
            await ApiClient.PauseQueueAsync().ConfigureAwait(false);
            _isPaused = true;
            StateHasChanged();
            Snackbar.Add("Queue paused successfully", Severity.Success);
            Logger.LogInformation("Successfully paused queue");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error pausing queue");
            Snackbar.Add($"Error pausing queue: {ex.Message}", Severity.Error);
        }
    }

    private async Task ResumeQueue()
    {
        Logger.LogInformation("User action: Resuming queue");
        try
        {
            await ApiClient.ResumeQueueAsync().ConfigureAwait(false);
            _isPaused = false;
            StateHasChanged();
            Snackbar.Add("Queue resumed successfully", Severity.Success);
            Logger.LogInformation("Successfully resumed queue");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error resuming queue");
            Snackbar.Add($"Error resuming queue: {ex.Message}", Severity.Error);
        }
    }

    private async Task StopQueue()
    {
        Logger.LogInformation("User action: Stopping queue");
        try
        {
            await ApiClient.StopQueueAsync().ConfigureAwait(false);
            _isPaused = false;
            await LoadConversionsAsync().ConfigureAwait(false);
            Snackbar.Add("Queue stopped successfully", Severity.Success);
            Logger.LogInformation("Successfully stopped queue");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error stopping queue");
            Snackbar.Add($"Error stopping queue: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCreateConversionDialog()
    {
        Logger.LogInformation("User action: Opening create conversion dialog");
        IDialogReference? dialogRef = null;
        dialogRef = await DialogService.ShowAsync<CreateConversionDialog>("Create Conversion", new DialogParameters<CreateConversionDialog>
        {
            { x => x.InitialModel, null },
            { x => x.OnSubmit, EventCallback.Factory.Create<ConversionCreateDto>(this, async (request) =>
            {
                await CreateConversionOptimisticAsync(request).ConfigureAwait(false);
                dialogRef?.Close();
                Logger.LogDebug("Create conversion dialog closed");
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        }, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        }).ConfigureAwait(false);
        Logger.LogDebug("Create conversion dialog opened");
    }

    private async Task OpenQueueDirectoryDialog()
    {
        Logger.LogInformation("User action: Opening queue directory dialog");
        IDialogReference? dialogRef = null;
        dialogRef = await DialogService.ShowAsync<QueueDirectoryDialog>("Queue Directory", new DialogParameters<QueueDirectoryDialog>
        {
            { x => x.InitialModel, null },
            { x => x.OnSubmit, EventCallback.Factory.Create<DirectoryQueueRequestDto>(this, async (request) =>
            {
                await QueueDirectoryAsync(request).ConfigureAwait(false);
                dialogRef?.Close();
                Logger.LogDebug("Queue directory dialog closed");
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        }, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        }).ConfigureAwait(false);
        Logger.LogDebug("Queue directory dialog opened");
    }

    private async Task OpenEditConversionDialog(ConversionDto conversion)
    {
        Logger.LogInformation("User action: Opening edit conversion dialog for conversion {ConversionId}", conversion.Id);
        IDialogReference? dialogRef = null;
        dialogRef = await DialogService.ShowAsync<EditConversionDialog>("Edit Conversion", new DialogParameters<EditConversionDialog>
        {
            { x => x.Conversion, conversion },
            { x => x.OnSubmit, EventCallback.Factory.Create<ConversionPatchDto>(this, async (patch) =>
            {
                await UpdateConversionAsync(conversion.Id, patch).ConfigureAwait(false);
                dialogRef?.Close();
                Logger.LogDebug("Edit conversion dialog closed");
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        }, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        }).ConfigureAwait(false);
        Logger.LogDebug("Edit conversion dialog opened");
    }

    private async Task UpdateConversionAsync(int id, ConversionPatchDto patch)
    {
        Logger.LogInformation("Updating conversion {ConversionId}", id);
        try
        {
            var updated = await ApiClient.UpdateConversionAsync(id, patch).ConfigureAwait(false);
            Logger.LogInformation("Successfully updated conversion {ConversionId}", id);

            // Update the conversion in the list
            await InvokeAsync(() =>
            {
                var index = _conversions.FindIndex(c => c.Id == id);
                if (index >= 0)
                {
                    _conversions[index] = updated;
                }
                else
                {
                    Logger.LogWarning("Conversion {ConversionId} not found in list after update", id);
                    _conversions.Insert(0, updated);
                }
                ResetPendingQueueFromServer();
                RecalculateQueueFlags();
                StateHasChanged();
            }).ConfigureAwait(false);

            Snackbar.Add("Conversion updated successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating conversion {ConversionId}", id);
            Snackbar.Add($"Error updating conversion: {ex.Message}", Severity.Error);
        }
    }

    private async Task CreateConversionOptimisticAsync(ConversionCreateDto request)
    {
        Logger.LogInformation("Creating conversion with optimistic update. Input: {InputPath}", request.InputPath);
        // Create a temporary conversion for optimistic update
        var tempId = GetNextTempId();
        var tempConversion = new ConversionDto(
            tempId,
            request.InputPath,
            request.OutputDirectory,
            DateTime.UtcNow,
            ConversionItemStatus.Pending,
            request.Crf,
            request.AudioBitrateKbps,
            request.AudioChannels,
            request.Resolution,
            request.OutputFilenameTemplate);

        Logger.LogDebug("Added temporary conversion with ID {TempId} for optimistic update", tempId);
        // Add optimistically to the list
        await InvokeAsync(() =>
        {
            _conversions.Insert(0, tempConversion);
            ResetPendingQueueFromServer();
            RecalculateQueueFlags();
            StateHasChanged();
        }).ConfigureAwait(false);

        try
        {
            // Make the actual API call
            var created = await ApiClient.CreateConversionAsync(request).ConfigureAwait(false);

            Logger.LogInformation("Conversion created successfully with ID {ConversionId}, replacing temporary ID {TempId}", 
                created.Id, tempId);
            // Replace the temporary conversion with the real one
            await InvokeAsync(() =>
            {
                var index = _conversions.FindIndex(c => c.Id == tempId);
                if (index >= 0)
                {
                    _conversions[index] = created;
                }
                else
                {
                    Logger.LogWarning("Temporary conversion {TempId} not found in list, adding created conversion at index 0", tempId);
                    // If not found, just add it (shouldn't happen, but be safe)
                    _conversions.Insert(0, created);
                }

                ResetPendingQueueFromServer();
                RecalculateQueueFlags();
                StateHasChanged();
            }).ConfigureAwait(false);

            Snackbar.Add("Conversion created successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating conversion, removing temporary conversion {TempId}", tempId);
            // Remove the temporary conversion on error
            await InvokeAsync(() =>
            {
                _conversions.RemoveAll(c => c.Id == tempId);
                ResetPendingQueueFromServer();
                RecalculateQueueFlags();
                StateHasChanged();
            }).ConfigureAwait(false);

            Snackbar.Add($"Error creating conversion: {ex.Message}", Severity.Error);
        }
    }

    private async Task QueueDirectoryAsync(DirectoryQueueRequestDto request)
    {
        Logger.LogInformation("Queueing directory for conversion. Directory: {DirectoryPath}", request.DirectoryPath);
        try
        {
            var batchId = await ApiClient.QueueDirectoryAsync(request).ConfigureAwait(false);
            Logger.LogInformation("Successfully queued directory with batch ID {BatchId}", batchId);
            Snackbar.Add($"Directory queued successfully. Batch ID: {batchId}", Severity.Success);

            // Refresh conversions list in case any were created immediately
            await LoadConversionsAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error queueing directory. Directory: {DirectoryPath}", request.DirectoryPath);
            Snackbar.Add($"Error queueing directory: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveQueueOrderAsync()
    {
        if (_pendingConversions.Count == 0 || !_pendingOrderDirty || _isSavingQueueOrder)
        {
            return;
        }

        _isSavingQueueOrder = true;
        StateHasChanged();
        try
        {
            var orderedIds = _pendingConversions.Select(c => c.Id).ToList();
            await ApiClient.ReorderQueueAsync(orderedIds).ConfigureAwait(false);
            Snackbar.Add("Queue order updated", Severity.Success);
            await LoadConversionsAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving queue order");
            Snackbar.Add($"Error saving queue order: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSavingQueueOrder = false;
            StateHasChanged();
        }
    }

    private void HandleQueueOrderChanged(List<ConversionDto> newOrder)
    {
        _pendingConversions.Clear();
        _pendingConversions.AddRange(newOrder);
        _pendingOrderDirty = true;
        StateHasChanged();
    }

    private int GetNextTempId()
    {
        // Use negative IDs for temporary conversions to avoid conflicts
        var existingTempIds = _conversions.Where(c => c.Id < 0).Select(c => c.Id).ToList();
        if (existingTempIds.Count == 0)
        {
            return -1;
        }

        return existingTempIds.Min() - 1;
    }

    private ConversionItemStatus GetEffectiveStatus(ConversionDto conversion)
    {
        // For Completed and Failed, use the status as-is
        if (conversion.Status == ConversionItemStatus.Completed || conversion.Status == ConversionItemStatus.Failed)
        {
            return conversion.Status;
        }

        // For Running/Pending, check progress data if available
        if (_progressData.TryGetValue(conversion.Id, out var progress) && progress != null)
        {
            return progress.Status == ConversionProgressStatus.Running
                ? ConversionItemStatus.Running
                : ConversionItemStatus.Pending;
        }

        // If no progress data, use the conversion status
        return conversion.Status;
    }

    private static Color GetStatusColor(ConversionItemStatus status)
    {
        return status switch
        {
            ConversionItemStatus.Pending => Color.Info,
            ConversionItemStatus.Running => Color.Warning,
            ConversionItemStatus.Completed => Color.Success,
            ConversionItemStatus.Failed => Color.Error,
            _ => Color.Default,
        };
    }

    public void Dispose()
    {
        Logger.LogInformation("Conversions page disposing, stopping progress polling");
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();
    }
}

