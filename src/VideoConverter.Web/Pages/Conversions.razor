@page "/conversions"
@using VideoConverter.Web.Components

<PageTitle>Conversions</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">All Conversions</MudText>
    </div>

    @if (_stateService.IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        <MudText>Loading conversions...</MudText>
    }
    else if (_conversions.Count == 0)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.body1">No conversions found.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_conversions" MultiSelection="true" @bind-SelectedItems="_selectedItems" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
            <ToolBarContent>
                <MudSpacer />
                @if (_selectedItems.Count > 0)
                {
                     <MudButton StartIcon="@Icons.Material.Filled.EditLocation" 
                               Variant="Variant.Filled" 
                               Color="Color.Warning" 
                               OnClick="OpenBatchResolveMetadataDialog"
                               Class="ml-2">
                        Fix Match (@_selectedItems.Count)
                    </MudButton>
                }
            </ToolBarContent>
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Input Path</MudTh>
                <MudTh>Output Directory</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>VMAF</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Input Path">
                    @if (!string.IsNullOrEmpty(context.MatchedTitle))
                    {
                        <div class="d-flex align-center gap-1 flex-wrap">
                            <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                @context.MatchedTitle
                                @if (context.MatchedYear.HasValue)
                                {
                                    <span class="ml-1">(@context.MatchedYear)</span>
                                }
                            </MudText>
                            @if (context.MatchedSeason.HasValue)
                            {
                                <MudText Typo="Typo.caption">S@(context.MatchedSeason)E@(context.MatchedEpisode)</MudText>
                            }
                            @if (context.TmdbId.HasValue)
                            {
                                <MudLink Href="@GetTmdbLink(context)" Target="_blank" Typo="Typo.caption" Class="ml-2">TMDb</MudLink>
                            }
                        </div>
                    }
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;" Color="@(string.IsNullOrEmpty(context.MatchedTitle) ? Color.Default : Color.Secondary)">
                        @context.InputPath
                    </MudText>
                    @if (!string.IsNullOrEmpty(context.MetadataBasedFilename))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Primary">
                            Output: @context.MetadataBasedFilename
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Output Directory">
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;">
                        @context.OutputDirectory
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Created">
                    <MudText Typo="Typo.body2">@context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @{
                        var effectiveStatus = _stateService.GetEffectiveStatus(context);
                        var progress = _stateService.GetProgress(context.Id);
                        var isRunning = effectiveStatus == ConversionStatus.Running && progress?.Status == ConversionProgressStatus.Running && !_stateService.IsPaused;
                        var isPaused = effectiveStatus == ConversionStatus.Running && _stateService.IsPaused;
                    }
                    @if (isPaused && progress != null)
                    {
                        <div>
                            <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Class="mb-2 status-paused">
                                Paused
                            </MudChip>
                            <MudProgressLinear Value="@(progress.PercentageComplete ?? 0)" Class="mb-1 status-paused" />
                            <MudText Typo="Typo.caption">
                                @if (progress.PercentageComplete.HasValue)
                                {
                                    <text>@($"{progress.PercentageComplete:F1}%")</text>
                                }
                            </MudText>
                        </div>
                    }
                    else if (isRunning && progress != null)
                    {
                        <div>
                            <MudChip T="ConversionStatus" Variant="Variant.Text" Size="Size.Small" Class="@($"mb-2 {GetStatusCssClass(effectiveStatus)}")">
                                @effectiveStatus
                            </MudChip>
                            <MudProgressLinear Value="@(progress.PercentageComplete ?? 0)" Class="@($"mb-1 {GetStatusCssClass(effectiveStatus)}")" />
                            <MudText Typo="Typo.caption">
                                @if (progress.PercentageComplete.HasValue)
                                {
                                    <text>@($"{progress.PercentageComplete:F1}%")</text>
                                }
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudChip T="ConversionStatus" Variant="Variant.Text" Size="Size.Small" Class="@GetStatusCssClass(effectiveStatus)">
                            @effectiveStatus
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="VMAF">
                    @if (context.VmafScore.HasValue)
                    {
                        <MudChip T="string" Size="Size.Small" Color="@GetVmafScoreColor(context.VmafScore.Value)">
                            @context.VmafScore.Value.ToString("F1")
                        </MudChip>
                    }
                    else if (context.Status == ConversionStatus.Pending)
                    {
                        @if (context.VmafEnabled)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Default" />
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                        }
                    }
                    else if (context.Status == ConversionStatus.Running)
                    {
                        @if (context.VmafEnabled)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Pending</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                        }
                    }
                    else if (context.Status == ConversionStatus.Completed && context.VmafEnabled)
                    {
                        <MudTooltip Text="VMAF calculation failed">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Warning" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    @if (context.Status == ConversionStatus.Pending)
                    {
                        @if (context.TmdbId == null)
                        {
                             <MudButton StartIcon="@Icons.Material.Filled.Search" OnClick="@(() => OpenResolveMetadataDialog(context))" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                Resolve
                            </MudButton>
                        }
                        else
                        {
                            <MudTooltip Text="Fix Match">
                                <MudIconButton Icon="@Icons.Material.Filled.EditLocation" OnClick="@(() => OpenResolveMetadataDialog(context))" Size="Size.Small" Color="Color.Default" />
                            </MudTooltip>
                        }
                    }

                    <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditConversionDialog(context))" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Disabled="@(context.Status == ConversionStatus.Deleted)">
                        Edit
                    </MudButton>
                    <MudButton StartIcon="@Icons.Material.Filled.Info" OnClick="@(() => OpenDetailsDialog(context))" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                        Details
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@implements IDisposable

@code {
    private IReadOnlyList<ConversionDto> _conversions = Array.Empty<ConversionDto>();
    private HashSet<ConversionDto> _selectedItems = new();

    [Inject]
    private ConversionStateService _stateService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private ILogger<Conversions> Logger { get; set; } = null!;

    [Inject]
    private IVideoConverterApiClient ApiClient { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Conversions page initializing");
        _stateService.StateChanged += OnStateChanged;
        await _stateService.LoadConversionsAsync().ConfigureAwait(false);
        _stateService.StartPolling();
        UpdateConversions();
        Logger.LogInformation("Conversions page initialized. Loaded {Count} conversions", _conversions.Count);
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        InvokeAsync(() =>
        {
            UpdateConversions();
            StateHasChanged();
        });
    }

    private void UpdateConversions()
    {
        _conversions = _stateService.Conversions;
    }

    private async Task OpenEditConversionDialog(ConversionDto conversion)
    {
        Logger.LogInformation("User action: Opening edit conversion dialog for conversion {ConversionId}", conversion.Id);
        IDialogReference? dialogRef = null;
        dialogRef = await DialogService.ShowAsync<EditConversionDialog>("Edit Conversion", new DialogParameters<EditConversionDialog>
        {
            { x => x.Conversion, conversion },
            { x => x.OnSubmit, EventCallback.Factory.Create<ConversionPatchDto>(this, async (patch) =>
            {
                await UpdateConversionAsync(conversion.Id, patch).ConfigureAwait(false);
                dialogRef?.Close();
                Logger.LogDebug("Edit conversion dialog closed");
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        }, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        }).ConfigureAwait(false);
        Logger.LogDebug("Edit conversion dialog opened");
    }

    private async Task OpenDetailsDialog(ConversionDto conversion)
    {
        var parameters = new DialogParameters<ConversionDetailsDialog> { { x => x.Conversion, conversion } };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<ConversionDetailsDialog>("Conversion Details", parameters, options);
    }

    private async Task OpenResolveMetadataDialog(ConversionDto conversion)
    {
        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<ResolveMetadataDialog>
        {
            { x => x.Conversion, conversion },
            { x => x.OnClose, EventCallback.Factory.Create<bool>(this, async (success) =>
                {
                    if (success)
                    {
                        dialogRef?.Close(DialogResult.Ok(true));
                        await _stateService.LoadConversionsAsync().ConfigureAwait(false);
                        Snackbar.Add("Metadata resolved successfully", Severity.Success);
                    }
                    else
                    {
                        dialogRef?.Close(DialogResult.Cancel());
                    }
                })
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        dialogRef = await DialogService.ShowAsync<ResolveMetadataDialog>("Resolve Metadata", parameters, options);
    }

    private async Task OpenBatchResolveMetadataDialog()
    {
        if (_selectedItems.Count == 0) return;

        var pendingItems = _selectedItems.Where(x => x.Status == ConversionStatus.Pending).ToList();

        if (pendingItems.Count == 0)
        {
            Snackbar.Add("Only pending conversions can be resolved. Please select pending items.", Severity.Warning);
            return;
        }

        if (pendingItems.Count < _selectedItems.Count)
        {
            Snackbar.Add($"Skipped {_selectedItems.Count - pendingItems.Count} non-pending items.", Severity.Info);
        }

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<ResolveMetadataDialog>
        {
            { x => x.Conversions, pendingItems },
            { x => x.OnClose, EventCallback.Factory.Create<bool>(this, async (success) =>
                {
                    if (success)
                    {
                        var count = pendingItems.Count;
                        dialogRef?.Close(DialogResult.Ok(true));
                        await _stateService.LoadConversionsAsync().ConfigureAwait(false);
                        _selectedItems.Clear();
                        Snackbar.Add($"Metadata resolved successfully for {count} items", Severity.Success);
                    }
                    else
                    {
                        dialogRef?.Close(DialogResult.Cancel());
                    }
                })
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        dialogRef = await DialogService.ShowAsync<ResolveMetadataDialog>("Resolve Batch Metadata", parameters, options);
    }

    private async Task UpdateConversionAsync(int id, ConversionPatchDto patch)
    {
        Logger.LogInformation("Updating conversion {ConversionId}", id);
        try
        {
            var updated = await ApiClient.UpdateConversionAsync(id, patch).ConfigureAwait(false);
            Logger.LogInformation("Successfully updated conversion {ConversionId}", id);
            _stateService.UpdateConversion(updated);
            Snackbar.Add("Conversion updated successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating conversion {ConversionId}", id);
            Snackbar.Add($"Error updating conversion: {ex.Message}", Severity.Error);
        }
    }

    private static string GetStatusCssClass(ConversionStatus status)
    {
        return status switch
        {
            ConversionStatus.Pending => "status-pending",
            ConversionStatus.Running => "status-running",
            ConversionStatus.Completed => "status-completed",
            ConversionStatus.Failed => "status-failed",
            ConversionStatus.Deleted => "status-deleted",
            _ => "",
        };
    }

    private static Color GetVmafScoreColor(double score) => score switch
    {
        >= 93 => Color.Success,
        >= 80 => Color.Info,
        >= 60 => Color.Warning,
        _ => Color.Error
    };

    private static string GetTmdbLink(ConversionDto item)
    {
        if (item.MatchedSeason.HasValue)
        {
            return $"https://www.themoviedb.org/tv/{item.TmdbId}";
        }
        return $"https://www.themoviedb.org/movie/{item.TmdbId}";
    }

    public void Dispose()
    {
        Logger.LogInformation("Conversions page disposing");
        _stateService.StateChanged -= OnStateChanged;
    }
}
