@page "/conversions"

<PageTitle>Conversions</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">All Conversions</MudText>
    </div>

    @if (_stateService.IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
        <MudText>Loading conversions...</MudText>
    }
    else if (_conversions.Count == 0)
    {
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.body1">No conversions found.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_conversions" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Input Path</MudTh>
                <MudTh>Output Directory</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.Id</MudTd>
                <MudTd DataLabel="Input Path">
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;">
                        @context.InputPath
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Output Directory">
                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;">
                        @context.OutputDirectory
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Created">
                    <MudText Typo="Typo.body2">@context.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss.fff")</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @{
                        var effectiveStatus = _stateService.GetEffectiveStatus(context);
                        var progress = _stateService.GetProgress(context.Id);
                        var isRunning = effectiveStatus == ConversionStatus.Running && progress?.Status == ConversionProgressStatus.Running && !_stateService.IsPaused;
                        var isPaused = effectiveStatus == ConversionStatus.Running && _stateService.IsPaused;
                    }
                    @if (isPaused && progress != null)
                    {
                        <div>
                            <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Class="mb-2 status-paused">
                                Paused
                            </MudChip>
                            <MudProgressLinear Value="@(progress.PercentageComplete ?? 0)" Class="mb-1 status-paused" />
                            <MudText Typo="Typo.caption">
                                @if (progress.PercentageComplete.HasValue)
                                {
                                    <text>@($"{progress.PercentageComplete:F1}%")</text>
                                }
                            </MudText>
                        </div>
                    }
                    else if (isRunning && progress != null)
                    {
                        <div>
                            <MudChip T="ConversionStatus" Variant="Variant.Text" Size="Size.Small" Class="@($"mb-2 {GetStatusCssClass(effectiveStatus)}")">
                                @effectiveStatus
                            </MudChip>
                            <MudProgressLinear Value="@(progress.PercentageComplete ?? 0)" Class="@($"mb-1 {GetStatusCssClass(effectiveStatus)}")" />
                            <MudText Typo="Typo.caption">
                                @if (progress.PercentageComplete.HasValue)
                                {
                                    <text>@($"{progress.PercentageComplete:F1}%")</text>
                                }
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <MudChip T="ConversionStatus" Variant="Variant.Text" Size="Size.Small" Class="@GetStatusCssClass(effectiveStatus)">
                            @effectiveStatus
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => OpenEditConversionDialog(context))" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Disabled="@(context.Status == ConversionStatus.Deleted)">
                        Edit
                    </MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@implements IDisposable

@code {
    private IReadOnlyList<ConversionDto> _conversions = Array.Empty<ConversionDto>();

    [Inject]
    private ConversionStateService _stateService { get; set; } = null!;

    [Inject]
    private ISnackbar Snackbar { get; set; } = null!;

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    [Inject]
    private ILogger<Conversions> Logger { get; set; } = null!;

    [Inject]
    private IVideoConverterApiClient ApiClient { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("Conversions page initializing");
        _stateService.StateChanged += OnStateChanged;
        await _stateService.LoadConversionsAsync().ConfigureAwait(false);
        _stateService.StartPolling();
        UpdateConversions();
        Logger.LogInformation("Conversions page initialized. Loaded {Count} conversions", _conversions.Count);
    }

    private void OnStateChanged(object? sender, EventArgs e)
    {
        InvokeAsync(() =>
        {
            UpdateConversions();
            StateHasChanged();
        });
    }

    private void UpdateConversions()
    {
        _conversions = _stateService.Conversions;
    }

    private async Task OpenEditConversionDialog(ConversionDto conversion)
    {
        Logger.LogInformation("User action: Opening edit conversion dialog for conversion {ConversionId}", conversion.Id);
        IDialogReference? dialogRef = null;
        dialogRef = await DialogService.ShowAsync<EditConversionDialog>("Edit Conversion", new DialogParameters<EditConversionDialog>
        {
            { x => x.Conversion, conversion },
            { x => x.OnSubmit, EventCallback.Factory.Create<ConversionPatchDto>(this, async (patch) =>
            {
                await UpdateConversionAsync(conversion.Id, patch).ConfigureAwait(false);
                dialogRef?.Close();
                Logger.LogDebug("Edit conversion dialog closed");
            }) },
            { x => x.OnCancel, EventCallback.Factory.Create(this, () => dialogRef?.Close()) },
        }, new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
        }).ConfigureAwait(false);
        Logger.LogDebug("Edit conversion dialog opened");
    }

    private async Task UpdateConversionAsync(int id, ConversionPatchDto patch)
    {
        Logger.LogInformation("Updating conversion {ConversionId}", id);
        try
        {
            var updated = await ApiClient.UpdateConversionAsync(id, patch).ConfigureAwait(false);
            Logger.LogInformation("Successfully updated conversion {ConversionId}", id);
            _stateService.UpdateConversion(updated);
            Snackbar.Add("Conversion updated successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating conversion {ConversionId}", id);
            Snackbar.Add($"Error updating conversion: {ex.Message}", Severity.Error);
        }
    }

    private static string GetStatusCssClass(ConversionStatus status)
    {
        return status switch
        {
            ConversionStatus.Pending => "status-pending",
            ConversionStatus.Running => "status-running",
            ConversionStatus.Completed => "status-completed",
            ConversionStatus.Failed => "status-failed",
            ConversionStatus.Deleted => "status-deleted",
            _ => "",
        };
    }

    public void Dispose()
    {
        Logger.LogInformation("Conversions page disposing");
        _stateService.StateChanged -= OnStateChanged;
    }
}
