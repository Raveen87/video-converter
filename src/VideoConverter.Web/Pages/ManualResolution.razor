@page "/manual-resolution"
@page "/metadata-queue"
@using VideoConverter.Common.Models
@using VideoConverter.Web.Components

@inject IVideoConverterApiClient ApiClient
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <div class="d-flex justify-space-between align-center mb-4">
        <MudText Typo="Typo.h4">Manual Resolution Queue</MudText>
        <div class="d-flex gap-2">
            <MudSelect T="ManualResolutionType?" Label="Filter" Value="_filterType" ValueChanged="OnFilterChanged" Variant="Variant.Outlined" Dense="true" Style="min-width: 150px;">
                <MudSelectItem T="ManualResolutionType?" Value="@((ManualResolutionType?)null)">All</MudSelectItem>
                <MudSelectItem T="ManualResolutionType?" Value="@ManualResolutionType.Metadata">Metadata</MudSelectItem>
                <MudSelectItem T="ManualResolutionType?" Value="@ManualResolutionType.StreamSelection">Stream Selection</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadQueueAsync">Refresh</MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled">No items pending manual resolution.</MudAlert>
    }
    else
    {
        <MudTable Items="@_items" MultiSelection="true" @bind-SelectedItems="_selectedItems" Hover="true" Striped="true" Breakpoint="Breakpoint.Sm">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Manual Resolution Queue</MudText>
                <MudSpacer />
                @if (_selectedItems.Count > 0 && _selectedItems.All(i => i.ResolutionType == ManualResolutionType.Metadata))
                {
                    <MudButton StartIcon="@Icons.Material.Filled.CheckCircle"
                              Variant="Variant.Filled"
                              Color="Color.Primary"
                              OnClick="OpenBatchResolveDialog"
                              Class="ml-2">
                        Resolve (@_selectedItems.Count)
                    </MudButton>
                }
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Type</MudTh>
                <MudTh>File</MudTh>
                <MudTh>Info</MudTh>
                <MudTh>Reason</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.ResolutionType)">
                        @GetTypeLabel(context.ResolutionType)
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="File">
                    <MudText Typo="Typo.body2">@context.SourceFileName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.SourcePath</MudText>
                </MudTd>
                <MudTd DataLabel="Info">
                    @if (context.ResolutionType == ManualResolutionType.Metadata)
                    {
                        @if (context.InputKind != "Unknown")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mr-1">@context.InputKind</MudChip>
                        }
                        <MudText Typo="Typo.body2" Class="d-inline">
                            @(context.ParsedTitle ?? "Unknown Title")
                            @if (context.ParsedYear.HasValue)
                            {
                                <span class="ml-1">(@context.ParsedYear)</span>
                            }
                            @if (context.ParsedSeason.HasValue)
                            {
                                <span class="ml-1">S@(context.ParsedSeason)E@(context.ParsedEpisode)</span>
                            }
                        </MudText>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(context.MissingAudioLanguages))
                        {
                            <MudText Typo="Typo.body2">Missing audio: @context.MissingAudioLanguages</MudText>
                        }
                        @if (!string.IsNullOrEmpty(context.MissingSubtitleLanguages))
                        {
                            <MudText Typo="Typo.body2">Missing subtitles: @context.MissingSubtitleLanguages</MudText>
                        }
                    }
                </MudTd>
                <MudTd DataLabel="Reason">
                    <MudTooltip Text="@context.FailureDetails">
                        <MudText Typo="Typo.body2">@context.FailureReason</MudText>
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Created">
                    <MudText Typo="Typo.body2">@context.CreatedAtUtc.ToLocalTime().ToString("g")</MudText>
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenResolveDialog(context))">Resolve</MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItem(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<ManualResolutionQueueItemDto> _items = new();
    private HashSet<ManualResolutionQueueItemDto> _selectedItems = new();
    private bool _isLoading = true;
    private ManualResolutionType? _filterType;

    protected override async Task OnInitializedAsync()
    {
        await LoadQueueAsync();
    }

    private async Task OnFilterChanged(ManualResolutionType? value)
    {
        _filterType = value;
        await LoadQueueAsync();
    }

    private async Task LoadQueueAsync()
    {
        _isLoading = true;
        _selectedItems.Clear();
        try
        {
            var items = await ApiClient.GetManualResolutionQueueItemsAsync(_filterType);
            _items = items.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading queue: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static Color GetTypeColor(ManualResolutionType type) => type switch
    {
        ManualResolutionType.Metadata => Color.Info,
        ManualResolutionType.StreamSelection => Color.Warning,
        _ => Color.Default
    };

    private static string GetTypeLabel(ManualResolutionType type) => type switch
    {
        ManualResolutionType.Metadata => "Metadata",
        ManualResolutionType.StreamSelection => "Streams",
        _ => "Unknown"
    };

    private async Task OpenResolveDialog(ManualResolutionQueueItemDto item)
    {
        if (item.ResolutionType == ManualResolutionType.Metadata)
        {
            await OpenMetadataResolveDialog(item);
        }
        else
        {
            await OpenStreamSelectionDialog(item);
        }
    }

    private async Task OpenMetadataResolveDialog(ManualResolutionQueueItemDto item)
    {
        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<ResolveMetadataDialog>
        {
            { x => x.ManualResolutionItem, item },
            { x => x.OnClose, EventCallback.Factory.Create<bool>(this, (success) =>
                {
                    if (success)
                    {
                        dialogRef?.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        dialogRef?.Close(DialogResult.Cancel());
                    }
                })
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        dialogRef = await DialogService.ShowAsync<ResolveMetadataDialog>("Resolve Metadata", parameters, options);
        var result = await dialogRef.Result;

        if (result is not null && !result.Canceled && result.Data is bool successResult && successResult)
        {
            Snackbar.Add("Item resolved and conversion created.", Severity.Success);
            await LoadQueueAsync();
        }
    }

    private async Task OpenStreamSelectionDialog(ManualResolutionQueueItemDto item)
    {
        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<ResolveStreamSelectionDialog>
        {
            { x => x.Item, item },
            { x => x.OnClose, EventCallback.Factory.Create<bool>(this, (success) =>
                {
                    if (success)
                    {
                        dialogRef?.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        dialogRef?.Close(DialogResult.Cancel());
                    }
                })
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        dialogRef = await DialogService.ShowAsync<ResolveStreamSelectionDialog>("Select Streams", parameters, options);
        var result = await dialogRef.Result;

        if (result is not null && !result.Canceled && result.Data is bool successResult && successResult)
        {
            Snackbar.Add("Item resolved and conversion created.", Severity.Success);
            await LoadQueueAsync();
        }
    }

    private async Task OpenBatchResolveDialog()
    {
        if (_selectedItems.Count == 0) return;

        IDialogReference? dialogRef = null;
        var parameters = new DialogParameters<ResolveMetadataDialog>
        {
            { x => x.ManualResolutionItems, _selectedItems.ToList() },
            { x => x.OnClose, EventCallback.Factory.Create<bool>(this, async (success) =>
                {
                    if (success)
                    {
                        var count = _selectedItems.Count;
                        dialogRef?.Close(DialogResult.Ok(true));
                        _selectedItems.Clear();
                        await LoadQueueAsync();
                        Snackbar.Add($"{count} items resolved and conversions created.", Severity.Success);
                    }
                    else
                    {
                        dialogRef?.Close(DialogResult.Cancel());
                    }
                })
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        dialogRef = await DialogService.ShowAsync<ResolveMetadataDialog>("Resolve Batch Metadata", parameters, options);
    }

    private async Task DeleteItem(ManualResolutionQueueItemDto item)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Delete Item",
            "Are you sure you want to remove this item from the queue? It will be skipped.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                await ApiClient.DeleteManualResolutionQueueItemAsync(item.Id);
                Snackbar.Add("Item removed from queue.", Severity.Success);
                await LoadQueueAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting item: {ex.Message}", Severity.Error);
            }
        }
    }
}
