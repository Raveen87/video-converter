@page "/"

<PageTitle>Overview</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">Welcome to Video Converter</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.VideoSettings" Class="mr-2" />
                    Conversions
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    View and manage your video conversions. Monitor progress, start, pause, or stop conversions.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/conversions">
                    View Conversions
                </MudButton>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                    Profiles
                </MudText>
                <MudText Typo="Typo.body2" Class="mb-3">
                    Create and manage conversion profiles with predefined settings for quick conversion setup.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="true">
                    Coming Soon
                </MudButton>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
