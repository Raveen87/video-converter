{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=conversions.db"
  },
  "Ffmpeg": {
    "Path": "ffmpeg",
    "DryRun": false,
    "VideoCodec": "libsvtav1",
    "PixelFormat": "yuv420p10le",
    "Preset": "6",
    "Tune": "0",
    "Gop": "120",
    "SvtParams": "film-grain=8:film-grain-denoise=0",
    "AudioCodec": "libopus",
    "DefaultAudioBitrateKbps": 128
  },
  "FilenameTemplate": {
    "DefaultTemplate": "{Title}.{Year}.S{Season:00}E{Episode:00}.{EpisodeName}.{Source}"
  },
  "MetadataFetch": {
    "OnFailureBehavior": "QueueForManualResolution"
  },
  "Tmdb": {
    "ApiKey": "YOUR_TMDB_API_KEY"
  }
}
